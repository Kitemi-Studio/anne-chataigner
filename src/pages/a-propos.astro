---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AboutHero from '../components/AboutHero.astro';
import AboutManifesto from '../components/AboutManifesto.astro';
import AboutStoryPath from '../components/AboutStoryPath.astro';
import AboutSignatureNotHere from '../components/AboutSignatureNotHere.astro';
import AboutCompass from '../components/AboutCompass.astro';
import AboutApproachesIndex from '../components/AboutApproachesIndex.astro';
import AboutCabinet from '../components/AboutCabinet.astro';
import AboutFaqAndCta from '../components/AboutFaqAndCta.astro';

const aboutFaq = [
  {
    question: "Quel est votre cadre déontologique et éthique ?",
    answer: "Mon exercice professionnel repose sur des principes stricts et non négociables : <strong>confidentialité absolue</strong> de tout ce qui est partagé en séance, <strong>absence totale de jugement</strong>, respect scrupuleux de votre intégrité et de votre rythme, et transparence totale sur les limites de mon champ de compétences."
  },
  {
    question: "Comment combinez-vous coaching, thérapies brèves et hypnose ?",
    answer: "Je pratique une <strong>approche intégrative sur-mesure</strong> : les outils ne sont jamais appliqués de façon dogmatique. Lors de notre première rencontre, nous clarifions votre besoin. Nous pouvons mobiliser le coaching pour clarifier une décision, les thérapies brèves pour apaiser une charge émotionnelle, et l'hypnose pour désactiver un automatisme inconscient."
  },
  {
    question: "Où se situe exactement votre cabinet ?",
    answer: "Le cabinet est situé au <strong>2 Rue de la Bergerie à Voisins-le-Bretonneux (78960)</strong>, dans un cadre calme et discret, facile d'accès depuis Versailles, Guyancourt, Montigny-le-Bretonneux et toute l'agglomération de Saint-Quentin-en-Yvelines (stationnement aisé à proximité)."
  },
  {
    question: "Proposez-vous des consultations à distance ?",
    answer: "Oui, l'ensemble de mes accompagnements (coaching, thérapies brèves, hypnose et consultation de couple) est accessible en <strong>visioconférence sécurisée</strong>, avec la même qualité de présence et de résultats."
  },
  {
    question: "Comment se déroule la prise de contact initiale ?",
    answer: "Vous pouvez réserver directement votre créneau via le bouton de prise de rendez-vous en ligne, ou m'adresser un message pour poser une question préalable. Dès notre première séance, nous faisons le point sur votre situation en toute simplicité."
  }
];
---

<Layout 
  title="À propos d'Anne Chataigner · Thérapeute à Voisins-le-Bretonneux"
  description="Découvrez le parcours d'Anne Chataigner, son expérience de plus de 20 ans en accompagnement humain et sa vision intégrative du coaching, des thérapies brèves et de l'hypnose dans les Yvelines."
>
  <Navbar variant="home" slot="navbar" />

  <main id="main-content" class="ac-page--about">
    <AboutHero />
    <AboutManifesto />
    <AboutStoryPath />
    <AboutSignatureNotHere />
    <AboutCompass />
    <AboutApproachesIndex />
    <AboutCabinet />
    <AboutFaqAndCta faqItems={aboutFaq} />
  </main>

  <Footer variant="home" slot="footer" />
</Layout>

<script is:inline src="/assets/js/lenis.min.js"></script>
<script is:inline>
  (() => {
    const page = document.querySelector('.ac-page--about');
    if (!page) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis = null;

    if (!reduceMotion && typeof window.Lenis !== 'undefined') {
      lenis = new window.Lenis({
        duration: 1.12,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.15
      });

      const raf = (time) => {
        lenis.raf(time);
        window.requestAnimationFrame(raf);
      };
      window.requestAnimationFrame(raf);
    }

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          event.preventDefault();
          if (lenis) {
            lenis.scrollTo(target, { offset: -30, duration: 1.2 });
          } else {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('[data-coaching-reveal]').forEach((el) => {
      observer.observe(el);
    });
  })();
</script>
