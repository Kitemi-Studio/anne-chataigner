---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeroAtmospheric from '../components/PageHeroAtmospheric.astro';
import SituationCloud from '../components/SituationCloud.astro';
import InsightSection from '../components/InsightSection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import BenefitGrid from '../components/BenefitGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedServices from '../components/RelatedServices.astro';
import InteriorCta from '../components/InteriorCta.astro';

const coachingTags = [
  { text: "Reconversion professionnelle", color: "blue", size: "lg" },
  { text: "Prise de nouvelles responsabilités", color: "slate", size: "md" },
  { text: "Perte de sens & démotivation", color: "terracotta", size: "md" },
  { text: "Syndrome de l'imposteur", color: "rose", size: "sm" },
  { text: "Charge mentale du dirigeant", color: "blue", size: "lg" },
  { text: "Carrefour de vie pro / perso", color: "green", size: "md" },
  { text: "Apprendre à poser ses limites", color: "amber", size: "md" },
  { text: "Sortir de la procrastination", color: "terracotta", size: "sm" },
  { text: "Préparer un départ ou une retraite", color: "sage", size: "md" },
  { text: "Dilemme & décision complexe", color: "blue", size: "lg" },
  { text: "Retrouver son énergie d'action", color: "amber", size: "md" },
  { text: "Clarification d'un projet de création", color: "green", size: "sm" },
  { text: "Gestion des conflits d'équipe", color: "slate", size: "md" },
  { text: "Faire un pas de côté salutaire", color: "blue", size: "lg" }
];

const coachingSteps = [
  {
    number: "Étape 01",
    title: "Clarifier la situation & poser l'intention",
    description: "Nous cartographions vos enjeux réels, ce qui vous pèse ou freine votre progression. Nous transformons le flou ou le doute en une intention claire et inspirante.",
    keypoints: [
      "État des lieux complet sans jugement",
      "Tri des priorités essentielles",
      "Formulation d'un cap motivant"
    ]
  },
  {
    number: "Étape 02",
    title: "Explorer vos leviers & lever les freins",
    description: "Nous identifions vos compétences clés souvent sous-estimées et déconstruisons les croyances limitantes qui bloquent votre prise de décision.",
    keypoints: [
      "Mise en lumière de vos forces propres",
      "Désamorçage des doutes et peurs d'échouer",
      "Changement de perspective sur vos options"
    ]
  },
  {
    number: "Étape 03",
    title: "Avancer par petits pas & ancrer le changement",
    description: "Vous élaborez un plan d'action réaliste et mesurable. Entre chaque séance, vous expérimentez de nouveaux comportements pour créer une dynamique pérenne.",
    keypoints: [
      "Actions concrètes et adaptées à votre rythme",
      "Expérimentations observables au quotidien",
      "Autonomie et confiance durable"
    ]
  }
];

const coachingBenefits = [
  {
    step: "01",
    title: "Clarté & Vision d'avenir",
    description: "Sortez du brouillard mental. Vous savez exactement où vous voulez aller et quelles sont vos véritables priorités.",
    color: "blue",
    iconType: "compass"
  },
  {
    step: "02",
    title: "Confiance & Posture affirmée",
    description: "Renforcez votre légitimité, osez poser des limites sereines et communiquez vos choix avec assurance.",
    color: "terracotta",
    iconType: "shield"
  },
  {
    step: "03",
    title: "Alignement personnel",
    description: "Réconciliez vos aspirations profondes avec les réalités de votre quotidien professionnel et personnel.",
    color: "sage",
    iconType: "heart"
  },
  {
    step: "04",
    title: "Énergie & Mouvement concret",
    description: "Dépassez l'inertie et la procrastination grâce à la méthode des petits pas réalistes et motivants.",
    color: "amber",
    iconType: "zap"
  }
];

const coachingFaq = [
  {
    question: "Quelle est la différence entre le coaching individuel et une thérapie brève ?",
    answer: "Le <strong>coaching</strong> est particulièrement tourné vers l'avenir, la clarification d'un objectif, la prise de décision et la mise en mouvement (transition professionnelle, nouveau projet, alignement personnel). Les <strong>thérapies brèves</strong> s'attachent davantage à apaiser un vécu émotionnel, surmonter une anxiété ou dénouer un blocage profond. Lors de notre première consultation, nous évaluons ensemble l'approche la plus juste pour votre situation."
  },
  {
    question: "Combien de séances sont généralement nécessaires ?",
    answer: "Le coaching s'inscrit dans une démarche pragmatique et brève. En moyenne, un accompagnement compte <strong>4 à 8 séances</strong> espacées de deux à trois semaines, ce qui vous permet d'expérimenter concrètement les prises de conscience entre chaque rencontre. Le rythme s'adapte toujours à vos disponibilités."
  },
  {
    question: "Comment se déroulent les séances au cabinet et en visioconférence ?",
    answer: "Les séances peuvent se dérouler soit <strong>au cabinet à Voisins-le-Bretonneux (78960)</strong>, dans un cadre calme, feutré et confidentiel, soit <strong>en visioconférence</strong> via un lien sécurisé avec la même dynamique d'échange et d'efficacité."
  },
  {
    question: "Faut-il avoir un objectif parfaitement clair pour démarrer ?",
    answer: "Non, absolument pas. Il arrive très souvent que l'on ressente un besoin de changement ou un sentiment de stagnation sans réussir à formuler un objectif précis. La toute première étape du coaching consiste justement à poser ce qui est là, trier les priorités et clarifier ensemble ce vers quoi vous souhaitez cheminer."
  },
  {
    question: "Le coaching est-il adapté aux personnes en poste ou en reconversion ?",
    answer: "Tout à fait. Que vous souhaitiez évoluer au sein de votre entreprise actuelle, négocier une transition, préparer une reconversion complète ou créer votre propre activité, le coaching vous apporte le recul stratégique et le soutien méthodologique nécessaires."
  },
  {
    question: "Qu'est-ce que l'approche par 'petits pas' ?",
    answer: "Le changement durable ne naît pas d'une rupture brutale, mais d'une succession de micro-actions réalistes et sécurisantes. En validant de petites victoires régulières, vous créez une spirale ascendante de confiance qui transforme naturellement votre quotidien."
  }
];
---

<Layout 
  title="Coaching individuel à Voisins-le-Bretonneux · Anne Chataigner"
  description="Accompagnement en coaching pour clarifier vos choix, traverser une transition professionnelle ou personnelle et remettre du mouvement dans votre quotidien dans les Yvelines."
>
  <Navbar slot="navbar" />

  <main id="main-content">
    <!-- Hero Header Atmosphérique Immersion (Reprise de l'Accueil) -->
    <PageHeroAtmospheric 
      badgeText="Coaching individuel & de transition"
      badgeType="coaching"
      title="Remettre du mouvement et clarifier votre cap."
      lead="Quand une situation stagne, que les repères vacillent ou qu'une décision tarde à se prendre, le coaching vous offre un espace sécurisant et structurant pour prendre du recul, mobiliser vos ressources et retrouver un élan durable."
      primaryCtaText="Prendre rendez-vous"
      primaryCtaLink="#contact"
      secondaryCtaText="Découvrir la méthode"
      secondaryCtaLink="#reperes"
      scrollTargetId="reperes"
      scrollLabel="Découvrir"
    />

    <!-- Section 1 : Nuage de Situations & Résonance -->
    <SituationCloud 
      subtitle="Votre point de départ"
      title="Des situations concrètes dans lesquelles vous pouvez vous reconnaître"
      lead="Le coaching s'adresse à toute personne souhaitant faire évoluer une situation, qu'il s'agisse d'un défi professionnel, d'un changement de vie ou d'une recherche d'alignement personnel."
      tags={coachingTags}
      quote="« On ne résout pas un problème avec les mêmes modes de pensée que ceux qui l'ont engendré. » — <em>Albert Einstein</em>"
      sectionId="reperes"
      theme="coaching"
    />

    <!-- Section 2 : Éclairage Palo Alto / Comprendre ce qui se joue -->
    <InsightSection 
      badgeText="Approche & Compréhension"
      badgeType="coaching"
      title="Comprendre ce qui se joue : Pourquoi forcer bloque souvent la situation"
      lead="Face à un obstacle, notre premier réflexe est souvent d'en faire 'toujours plus de la même chose'. Pourtant, l'insistance est parfois ce qui maintient le problème."
      bodyParagraphs={[
        "Inspirée par l'approche systémique de l'<strong>École de Palo Alto</strong>, ma pratique du coaching ne cherche pas à vous imposer des solutions toutes faites. Elle s'intéresse à la manière dont vos tentatives passées de résolution ont pu, bien involontairement, figer la situation.",
        "En prenant le temps de <strong>faire un pas de côté</strong>, nous analysons ensemble la mécanique de votre quotidien pour identifier les leviers inexplorés et stopper les boucles d'efforts stériles.",
        "Le coaching devient alors un accélérateur de lucidité : vous retrouvez votre liberté de choix et construisez des réponses véritablement adaptées à votre écologie personnelle."
      ]}
      highlightBoxTitle="Le principe du 'Pas de côté'"
      highlightBoxText="S'accorder une pause réflexive n'est pas une perte de temps : c'est la condition indispensable pour cesser de subir une transition et commencer à la piloter avec clairvoyance."
      keypoints={[
        { title: "Arrêt des efforts stériles", description: "Identifier les stratégies qui vous épuisent sans donner de résultats." },
        { title: "Nouveau regard stratégique", description: "Envisager des options inattendues et débloquer les impasses." },
        { title: "Respect de votre rythme", description: "Un accompagnement qui s'adapte à vos contraintes et à votre réalité." }
      ]}
      sectionId="approche-eclairage"
      bgColor="#ffffff"
    />

    <!-- Section 3 : Déroulement en 3 étapes clés -->
    <ProcessTimeline 
      subtitle="Méthode & Cheminement"
      title="Le déroulement de l'accompagnement en 3 étapes"
      lead="Un cadre feutré, bienveillant et résolument pragmatique pour transformer vos réflexions en résultats concrets."
      steps={coachingSteps}
      pricingBanner={{
        tag: "Modalités & Tarif",
        title: "Consultation individuelle de Coaching",
        description: "Séance d'1 heure au cabinet de Voisins-le-Bretonneux ou en visioconférence. Un cadre sécurisant et structurant.",
        amount: "85 €",
        duration: "Durée : 1 heure",
        linkText: "Consulter tous les tarifs →",
        linkUrl: "/tarifs",
        tagColor: "#2F425E"
      }}
      sectionId="deroulement"
      bgColor="#F8FAFC"
    />

    <!-- Section 4 : Grille des 4 Clés de Transformation (Quadrant) -->
    <BenefitGrid 
      subtitle="Bénéfices & Transformations"
      title="Ce que le coaching individuel vous permet d'accomplir"
      lead="Des bénéfices observables dans votre quotidien professionnel et personnel, sans promesse magique mais avec une méthode éprouvée."
      cards={coachingBenefits}
      sectionId="benefices"
    />

    <!-- Section 5 : FAQ Accordéon Détaillée -->
    <FaqAccordion 
      items={coachingFaq}
      subtitle="Questions fréquentes"
      title="Tout comprendre sur le coaching individuel"
      badgeType="coaching"
    />

    <!-- Section 6 : Passerelles vers les autres approches -->
    <RelatedServices currentService="coaching" />

    <!-- Section 7 : CTA Final -->
    <InteriorCta 
      title="Prêt(e) à clarifier votre cap et passer à l'action ?"
      lead="Un premier échange permet de poser ce qui se joue, de faire le point sur vos attentes et d'envisager ensemble la démarche la plus ajustée."
      buttonText="Prendre rendez-vous"
    />
  </main>

  <Footer slot="footer" />
</Layout>
