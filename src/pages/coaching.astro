const coachingFaq = [
  {
    question: "Quelle est la différence entre le coaching individuel et une thérapie brève ?",
    answer: "Le <strong>coaching</strong> est particulièrement tourné vers l'avenir, la clarification d'un objectif, la prise de décision et la mise en mouvement (transition professionnelle, nouveau projet, alignement personnel). Les <strong>thérapies brèves</strong> s'attachent davantage à apaiser un vécu émotionnel, surmonter une anxiété ou dénouer un blocage profond. Lors de notre première consultation, nous évaluons ensemble l'approche la plus juste pour votre situation."
  },
  {
    question: "Combien de séances sont généralement nécessaires ?",
    answer: "Le coaching s'inscrit dans une démarche pragmatique et brève. En moyenne, un accompagnement compte <strong>4 à 8 séances</strong> espacées de deux à trois semaines, ce qui vous permet d'expérimenter concrètement les prises de conscience entre chaque rencontre. Le rythme s'adapte toujours à vos disponibilités."
  },
  {
    question: "Comment se déroulent les séances au cabinet et en visioconférence ?",
    answer: "Les séances peuvent se dérouler soit <strong>au cabinet à Voisins-le-Bretonneux (78960)</strong>, dans un cadre calme, feutré et confidentiel, soit <strong>en visioconférence</strong> via un lien sécurisé avec la même dynamique d'échange et d'efficacité."
  },
  {
    question: "Faut-il avoir un objectif parfaitement clair pour démarrer ?",
    answer: "Non, absolument pas. Il arrive très souvent que l'on ressente un besoin de changement ou un sentiment de stagnation sans réussir à formuler un objectif précis. La toute première étape du coaching consiste justement à poser ce qui est là, trier les priorités et clarifier ensemble ce vers quoi vous souhaitez cheminer."
  },
  {
    question: "Le coaching est-il adapté aux personnes en poste ou en reconversion ?",
    answer: "Tout à fait. Que vous souhaitiez évoluer au sein de votre entreprise actuelle, négocier une transition, préparer une reconversion complète ou créer votre propre activité, le coaching vous apporte le recul stratégique et le soutien méthodologique nécessaires."
  },
  {
    question: "Qu'est-ce que l'approche par 'petits pas' ?",
    answer: "Le changement durable ne naît pas d'une rupture brutale, mais d'une succession de micro-actions réalistes et sécurisantes. En validant de petites victoires régulières, vous créez une spirale ascendante de confiance qui transforme naturellement votre quotidien."
  }
];
---

<Layout 
  title="Coaching individuel à Voisins-le-Bretonneux · Anne Chataigner"
  description="Accompagnement en coaching pour clarifier vos choix, traverser une transition professionnelle ou personnelle et remettre du mouvement dans votre quotidien dans les Yvelines."
>
  <Navbar variant="home" slot="navbar" />

  <main id="main-content">
    <CoachingHero />

    <CoachingSituations tags={coachingTags} />

    <CoachingMethod
      steps={coachingSteps}
      pricingBanner={{
        title: "Consultation individuelle de Coaching",
        description: "Séance d'1 heure au cabinet de Voisins-le-Bretonneux ou en visioconférence. Un cadre sécurisant et structurant.",
        amount: "85 €",
        duration: "Durée : 1 heure",
        linkText: "Consulter tous les tarifs",
        linkUrl: "/tarifs"
      }}
    />

    <CoachingBenefits cards={coachingBenefits} />

    <FaqAccordion 
      items={coachingFaq}
      subtitle="Questions fréquentes"
      title="Tout ce que vous devez savoir avant de débuter."
      badgeType="coaching"
      variant="home"
    />

    <section class="section coaching-next-steps" id="suite">
      <div class="w-layout-blockcontainer container w-container">
        <div class="vertical-wrapper">
          <div class="vertical-headline program-heading-home-b" data-coaching-reveal>
            <div class="subtitle">Pour aller plus loin</div>
            <h2 class="heading-2">Une approche ajustée à ce que vous traversez.</h2>
          </div>
          <div class="three-programs-grid coaching-next-steps__grid">
            <a href="/therapies-breves" class="program-card-modern" data-coaching-reveal>
              <div class="program-card-bg-wrapper"><img loading="lazy" src="/assets/image%203.png" alt="Thérapies brèves au cabinet" class="program-card-bg-img" /><div class="program-card-gradient-overlay"></div></div>
              <div class="program-card-top-tag"><span class="program-card-tag-pill tag-therapies">01 · Thérapies brèves</span></div>
              <div class="program-card-overlay-content"><h3 class="program-card-title-modern">Apaiser ce qui pèse</h3><p class="program-card-lead-modern">Dénouer les tensions et retrouver plus de fluidité dans votre quotidien.</p><div class="program-card-action-row"><span class="program-card-action-label">Découvrir</span><span class="program-card-action-btn" aria-hidden="true">↗</span></div></div>
            </a>
            <a href="/hypnose-ericksonienne" class="program-card-modern" data-coaching-reveal>
              <div class="program-card-bg-wrapper"><img loading="lazy" src="/assets/anne%20hero%20header%202%20-%20nouveau%20bureau.png" alt="Hypnose Ericksonienne au cabinet" class="program-card-bg-img" /><div class="program-card-gradient-overlay"></div></div>
              <div class="program-card-top-tag"><span class="program-card-tag-pill tag-hypnose">02 · Hypnose</span></div>
              <div class="program-card-overlay-content"><h3 class="program-card-title-modern">Mobiliser vos ressources</h3><p class="program-card-lead-modern">Ouvrir de nouvelles perspectives et activer vos solutions intérieures.</p><div class="program-card-action-row"><span class="program-card-action-label">Découvrir</span><span class="program-card-action-btn" aria-hidden="true">↗</span></div></div>
            </a>
            <a href="/consultation-couple" class="program-card-modern" data-coaching-reveal>
              <div class="program-card-bg-wrapper"><img loading="lazy" src="/assets/couple%20therapie%20-%20nouveau%20bureau.png" alt="Consultation de couple au cabinet" class="program-card-bg-img" /><div class="program-card-gradient-overlay"></div></div>
              <div class="program-card-top-tag"><span class="program-card-tag-pill tag-coaching">03 · Relationnel</span></div>
              <div class="program-card-overlay-content"><h3 class="program-card-title-modern">Cheminer ensemble</h3><p class="program-card-lead-modern">Retrouver un espace de dialogue, de compréhension et de mouvement.</p><div class="program-card-action-row"><span class="program-card-action-label">Découvrir</span><span class="program-card-action-btn" aria-hidden="true">↗</span></div></div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section cta coaching-cta" id="contact">
      <div class="cta-background">
        <div class="w-layout-blockcontainer container cta w-container">
          <div class="vertical-headline center">
            <h2 class="heading-1 cta-heading">Vous n’avez pas besoin d’aller mal pour avancer.</h2>
            <p class="text white coaching-cta__lead">Un premier échange permet de poser ce qui se joue, de faire le point sur vos attentes et d’envisager ensemble la démarche la plus ajustée.</p>
            <div class="button-wrapper">
              <a href="/#contact" data-wf--button--variant="white" class="primary-button w-variant-df50d2b4-2dcf-06cb-393e-886e8cb0681e w-inline-block" data-booking-link>
                <div class="button-text-wrapper"><div class="button-text-inner"><div button-text="" class="button-text">Prendre rendez-vous</div><div button-text="" class="button-text">Prendre rendez-vous</div></div></div>
              </a>
              <a href="#accueil" data-wf--button--variant="secondary-white" class="primary-button button-hero-secondary w-variant-f0ba9e15-0444-e4fc-a8e1-1c47fa2d65ed w-inline-block">
                <div class="button-text-wrapper"><div class="button-text-inner"><div button-text="" class="button-text">Revenir en haut ↑</div><div button-text="" class="button-text">Revenir en haut ↑</div></div></div>
              </a>
            </div>
            <div class="cta-cabinet-info"><span><svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.5 8.2c0 4.1-6.5 8.8-6.5 8.8S3.5 12.3 3.5 8.2a6.5 6.5 0 1 1 13 0Z" stroke="currentColor" stroke-width="1.3"></path><circle cx="10" cy="8" r="2.1" stroke="currentColor" stroke-width="1.3"></circle></svg>Cabinet à Voisins-le-Bretonneux · 2 Rue de la Bergerie, 78960</span></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer variant="home" slot="footer" />
</Layout>

<script is:inline src="/assets/js/lenis.min.js"></script>
<script is:inline>
  (() => {
    const page = document.querySelector('.ac-page--coaching');
    if (!page) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis = null;

    if (!reduceMotion && typeof window.Lenis !== 'undefined') {
      lenis = new window.Lenis({
        duration: 1.12,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.15
      });

      const raf = (time) => {
        lenis.raf(time);
        window.requestAnimationFrame(raf);
      };
      window.requestAnimationFrame(raf);
    }

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const targetId = anchor.getAttribute('href');
        const target = targetId && document.querySelector(targetId);
        if (!target) return;
        event.preventDefault();
        if (lenis) {
          lenis.scrollTo(target, { offset: -92, duration: 1.1 });
        } else {
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        }
      });
    });

    const revealItems = document.querySelectorAll('[data-coaching-reveal]');
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -8%' });
      revealItems.forEach((item) => revealObserver.observe(item));
    }

    const steps = [...document.querySelectorAll('[data-coaching-step]')];
    const journey = document.querySelector('[data-coaching-journey]');
    const progress = document.querySelector('#coachingJourneyProgress');

    const updateJourneyProgress = () => {
      if (!journey || !progress) return;
      const rect = journey.getBoundingClientRect();
      const focus = window.innerHeight * 0.52;
      const value = Math.max(0, Math.min(1, (focus - rect.top) / rect.height));
      progress.style.transform = `scaleY(${value})`;
    };

    const setActiveStep = (index) => {
      steps.forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex === index));
    };

    if (steps.length && 'IntersectionObserver' in window) {
      const stepObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = Math.max(0, steps.indexOf(entry.target));
          setActiveStep(index);
        });
      }, { threshold: 0.42, rootMargin: '-24% 0px -42%' });
      steps.forEach((step) => stepObserver.observe(step));
    }

    if (lenis) {
      lenis.on('scroll', updateJourneyProgress);
    } else {
      window.addEventListener('scroll', updateJourneyProgress, { passive: true });
    }

    if (reduceMotion) {
      setActiveStep(0);
    }
    updateJourneyProgress();
  })();
</script>
