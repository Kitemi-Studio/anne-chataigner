---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CoachingHero from '../components/CoachingHero.astro';
import CoachingSituations from '../components/CoachingSituations.astro';
import CoachingMethod from '../components/CoachingMethod.astro';
import CoachingBenefits from '../components/CoachingBenefits.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const coachingTags = [
  { text: "Reconversion professionnelle", color: "blue", size: "lg" },
  { text: "Prise de nouvelles responsabilités", color: "slate", size: "md" },
  { text: "Perte de sens & démotivation", color: "blue", size: "md" },
  { text: "Syndrome de l'imposteur", color: "slate", size: "sm" },
  { text: "Charge mentale du dirigeant", color: "blue", size: "lg" },
  { text: "Carrefour de vie pro / perso", color: "slate", size: "md" },
  { text: "Apprendre à poser ses limites", color: "blue", size: "md" },
  { text: "Sortir de la procrastination", color: "slate", size: "sm" },
  { text: "Préparer un départ ou une retraite", color: "blue", size: "md" },
  { text: "Dilemme & décision complexe", color: "slate", size: "lg" },
  { text: "Retrouver son énergie d'action", color: "blue", size: "md" },
  { text: "Clarification d'un projet de création", color: "slate", size: "sm" },
  { text: "Gestion des conflits d'équipe", color: "blue", size: "md" },
  { text: "Faire un pas de côté salutaire", color: "slate", size: "lg" }
];

const coachingSteps = [
  {
    number: "Étape 01 · Prendre du recul",
    title: "Arrêt des efforts stériles",
    mantra: "Cesser de faire plus de la même chose",
    description: "Nous mettons à plat ce qui vous épuise et repérons les stratégies qui entretiennent, malgré vous, l’immobilité ou la surcharge.",
    image: "/assets/step-1-ecouter%20-%20nouveau%20bureau.png",
    imageAlt: "Échange de coaching dans un cabinet chaleureux",
    tone: "blue",
    keypoints: [
      "État des lieux sans jugement",
      "Tri des priorités essentielles",
      "Une première respiration"
    ]
  },
  {
    number: "Étape 02 · Ouvrir le champ",
    title: "Nouveau regard stratégique",
    mantra: "Voir autrement pour choisir autrement",
    description: "Nous faisons émerger vos ressources, vos options et les angles morts qui empêchent parfois une décision claire ou un changement de posture.",
    image: "/assets/step-2-explorer%20-%20nouveau%20bureau.png",
    imageAlt: "Anne Chataigner accompagne une réflexion en séance",
    tone: "blue",
    keypoints: [
      "Mise en lumière de vos forces",
      "Nouvelles options possibles",
      "Décisions plus lisibles"
    ]
  },
  {
    number: "Étape 03 · Passer à l’action",
    title: "Respecter votre rythme",
    mantra: "Avancer assez pour que le changement tienne",
    description: "Vous testez des actions concrètes, à la bonne échelle, puis nous observons ce qui fonctionne pour construire un mouvement durable et vraiment vôtre.",
    image: "/assets/step-4-avancer%20-%20Anne.png",
    imageAlt: "Anne Chataigner dans le jardin du cabinet",
    tone: "blue",
    keypoints: [
      "Actions adaptées à votre réalité",
      "Expérimentations observables",
      "Autonomie et confiance durable"
    ]
  }
];

const coachingBenefits = [
  {
    step: "01",
    eyebrow: "Voir plus clair",
    title: "Clarté & vision d’avenir",
    description: "Sortir du brouillard mental, distinguer l’essentiel et retrouver un cap qui donne envie d’avancer.",
    image: "/assets/anne%20hero%20header%202%20-%20nouveau%20bureau.png",
    imageAlt: "Anne Chataigner prépare une séance dans son cabinet",
    tone: "blue"
  },
  {
    step: "02",
    eyebrow: "Prendre sa place",
    title: "Confiance & posture affirmée",
    description: "Renforcer votre légitimité, poser des limites sereines et exprimer vos choix avec davantage d’assurance.",
    image: "/assets/step-4-avancer%20-%20Anne.png",
    imageAlt: "Anne Chataigner accueille dans un cadre extérieur apaisant",
    tone: "blue"
  },
  {
    step: "03",
    eyebrow: "Réconcilier",
    title: "Alignement personnel",
    description: "Faire dialoguer vos aspirations, vos contraintes et vos relations pour construire des choix qui vous ressemblent.",
    image: "/assets/couple%20therapie%20-%20nouveau%20bureau.png",
    imageAlt: "Un échange dans un espace de consultation chaleureux",
    tone: "blue"
  },
  {
    step: "04",
    eyebrow: "Mettre en mouvement",
    title: "Énergie & mouvement concret",
    description: "Dépassez l’inertie avec des petits pas réalistes, motivants et assez souples pour s’inscrire dans votre quotidien.",
    image: "/assets/image%203.png",
