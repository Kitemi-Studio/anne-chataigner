---

<Layout 
  title="Thérapies brèves à Voisins-le-Bretonneux (Yvelines) · Anne Chataigner"
  description="Accompagnement bienveillant et concret en thérapies brèves pour apaiser la charge mentale, dépasser un blocage et retrouver un équilibre émotionnel dans les Yvelines."
>
  <Navbar variant="home" slot="navbar" />

  <main id="main-content">
    <TherapiesHero />

    <TherapiesSituations tags={therapiesTags} />

    <TherapiesApproachDiagram />

    <TherapiesMethod
      steps={therapiesSteps}
      pricingBanner={{
        title: "Consultation individuelle de Thérapie brève",
        description: "Séance d'1 heure au cabinet de Voisins-le-Bretonneux ou en visioconférence. Remise systématique d'une facture pour votre mutuelle.",
        amount: "85 €",
        duration: "Durée : 1 heure",
        linkText: "Consulter tous les tarifs",
        linkUrl: "/tarifs"
      }}
    />

    <TherapiesBenefits cards={therapiesBenefits} />

    <FaqAccordion 
      items={therapiesFaq}
      subtitle="Questions fréquentes"
      title="Tout ce que vous devez savoir avant de débuter."
      badgeType="therapies"
      variant="home"
    />

    <TherapiesNextSteps />

    <TherapiesCta />
  </main>

  <Footer slot="footer" />
</Layout>

<script is:inline src="/assets/js/lenis.min.js"></script>
<script>
  (() => {
    const page = document.querySelector('.ac-page--therapies');
    if (!page || page.dataset.therapiesReady === 'true') return;
    page.dataset.therapiesReady = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lenis = (!reduceMotion && typeof window.Lenis === 'function')
      ? new window.Lenis({ duration: 1.1, smoothWheel: true })
      : null;

    if (lenis) {
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    }

    const revealItems = [...document.querySelectorAll('[data-coaching-reveal]')];
    if (revealItems.length && 'IntersectionObserver' in window && !reduceMotion) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -8%' });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }

    const steps = [...document.querySelectorAll('[data-coaching-step]')];
    const journey = document.querySelector('[data-coaching-journey]');
    const progress = document.querySelector('#therapiesJourneyProgress');

    const updateJourneyProgress = () => {
      if (!journey || !progress) return;
      const rect = journey.getBoundingClientRect();
      const focus = window.innerHeight * 0.52;
      const value = Math.max(0, Math.min(1, (focus - rect.top) / rect.height));
      progress.style.transform = `scaleY(${value})`;
    };

    const setActiveStep = (index: number) => {
      steps.forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex === index));
    };

    if (steps.length && 'IntersectionObserver' in window) {
      const stepObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = Math.max(0, steps.indexOf(entry.target));
          setActiveStep(index);
        });
      }, { threshold: 0.42, rootMargin: '-24% 0px -42%' });
      steps.forEach((step) => stepObserver.observe(step));
    }

    if (lenis) {
      lenis.on('scroll', updateJourneyProgress);
    } else {
      window.addEventListener('scroll', updateJourneyProgress, { passive: true });
    }

    if (reduceMotion) {
      setActiveStep(0);
    }
    updateJourneyProgress();
  })();
</script>
