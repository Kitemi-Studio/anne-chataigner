---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeroAtmospheric from '../components/PageHeroAtmospheric.astro';
import SituationCloud from '../components/SituationCloud.astro';
import InsightSection from '../components/InsightSection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import BenefitGrid from '../components/BenefitGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedServices from '../components/RelatedServices.astro';
import InteriorCta from '../components/InteriorCta.astro';

const therapiesTags = [
  { text: "Charge mentale & surcharge", color: "sage", size: "lg" },
  { text: "Anxiété & angoisses diffuses", color: "terracotta", size: "lg" },
  { text: "Régulation des émotions", color: "blue", size: "md" },
  { text: "Traversée d'une rupture", color: "rose", size: "md" },
  { text: "Période de deuil & perte", color: "slate", size: "sm" },
  { text: "Épuisement & pré-burnout", color: "terracotta", size: "lg" },
  { text: "Schémas relationnels répétitifs", color: "amber", size: "md" },
  { text: "Sommeil perturbé & insomnies", color: "blue", size: "md" },
  { text: "Hypersensibilité envahissante", color: "sage", size: "lg" },
  { text: "Peur du regard des autres", color: "rose", size: "sm" },
  { text: "Culpabilité & perfectionnisme", color: "slate", size: "md" },
  { text: "Estime de soi & bienveillance", color: "green", size: "lg" },
  { text: "Tensions familiales ou de couple", color: "amber", size: "md" },
  { text: "Envie de retrouver un équilibre", color: "sage", size: "lg" }
];

const therapiesSteps = [
  {
    number: "Étape 01",
    title: "Accueil & Dépose en toute sécurité",
    description: "Un espace d'écoute feutré et confidentiel pour exprimer ce qui pèse, poser vos émotions et vous sentir pleinement accueilli(e) sans aucun jugement.",
    keypoints: [
      "Écoute attentive et bienveillante",
      "Dépose de la charge émotionnelle",
      "Clarification de ce qui fait souffrance"
    ],
    badgeBg: "#E8EFE6",
    badgeColor: "#2E452A"
  },
  {
    number: "Étape 02",
    title: "Éclairer le système émotionnel",
    description: "Nous identifions les déclencheurs, les boucles de pensées automatiques et la manière dont vos réactions entretiennent involontairement le stress.",
    keypoints: [
      "Mise en lumière des cercles vicieux",
      "Compréhension des messages de vos émotions",
      "Désamorçage de l'autocritique"
    ],
    badgeBg: "#E8EFE6",
    badgeColor: "#2E452A"
  },
  {
    number: "Étape 03",
    title: "Expérimenter des outils concrets",
    description: "Nous pratiquons en séance des outils thérapeutiques simples et puissants (régulation du système nerveux, recadrage, visualisation, ancrages).",
    keypoints: [
      "Techniques de désactivation émotionnelle",
      "Exercices corporels et cognitifs",
      "Outils personnalisés à votre sensibilité"
    ],
    badgeBg: "#E8EFE6",
    badgeColor: "#2E452A"
  },
  {
    number: "Étape 04",
    title: "Intégrer et consolider au quotidien",
    description: "Vous repartez avec des repères clairs à appliquer dans vos journées. Au fil des séances, vous gagnez en autonomie et en paix intérieure.",
    keypoints: [
      "Micro-rituels d'apaisement chez vous",
      "Évaluation des progrès concrets",
      "Ancrage d'une sérénité durable"
    ],
    badgeBg: "#E8EFE6",
    badgeColor: "#2E452A"
  }
];

const therapiesBenefits = [
  {
    step: "01",
    title: "Apaisement du système nerveux",
    description: "Réduisez l'hyper-réactivité, les tensions corporelles et retrouvez un sentiment d'espace et de calme intérieur.",
    color: "sage",
    iconType: "feather"
  },
  {
    step: "02",
    title: "Recul face aux ruminations",
    description: "Sortez du flux incessant des pensées anxieuses et apprenez à observer vos émotions sans vous laisser submerger.",
    color: "blue",
    iconType: "eye"
  },
  {
    step: "03",
    title: "Sortie des schémas répétitifs",
    description: "Cassez les automatismes comportementaux qui vous enferment dans des réactions douloureuses ou conflictuelles.",
    color: "terracotta",
    iconType: "shield"
  },
  {
    step: "04",
    title: "Autonomie & Confiance durable",
    description: "Acquérez une boîte à outils pragmatique et réutilisable pour traverser sereinement les futurs aléas de la vie.",
    color: "amber",
    iconType: "heart"
  }
];

const therapiesFaq = [
  {
    question: "Faut-il attendre d'être au plus mal pour consulter en thérapie brève ?",
    answer: "<strong>Non, absolument pas.</strong> C'est l'un des principes fondamentaux de ma pratique : <em>il n'est pas nécessaire d'aller très mal pour avoir envie d'aller mieux</em>. Consulter dès les premiers signes de fatigue émotionnelle, de flou ou de surcharge permet d'éviter que les tensions ne s'ancrent et d'apaiser rapidement la situation."
  },
  {
    question: "En quoi consistent les thérapies brèves par rapport à une psychanalyse ou psychothérapie classique ?",
    answer: "Les thérapies brèves se concentrent principalement sur le <strong>présent et la recherche de solutions concrètes</strong> (« comment faire pour que cela change ? »), plutôt que sur une analyse exhaustive et rétrospective du passé. L'objectif est de vous transmettre des clés pratiques et observables pour retrouver rapidement de l'autonomie et de la sérénité."
  },
  {
    question: "Combien de séances faut-il prévoir ?",
    answer: "Comme leur nom l'indique, ces accompagnements sont pragmatiques et limités dans le temps. La plupart des personnes constatent des évolutions sensibles en <strong>4 à 8 séances</strong>. Vous restez toujours libre d'espacer ou d'arrêter les consultations dès que vous ressentez le mieux-être souhaité."
  },
  {
    question: "Les séances sont-elles prises en charge par les mutuelles ?",
    answer: "Ces consultations ne sont pas prises en charge par la Sécurité Sociale, mais de très nombreuses <strong>mutuelles et complémentaires santé</strong> proposent des forfaits annuels « médecines douces » ou « bien-être » qui remboursent tout ou partie des séances. Une facture détaillée vous est remise à l'issue de chaque rencontre."
  },
  {
    question: "Que se passe-t-il si mon motif relève d'une prise en charge médicale ou psychiatrique ?",
    answer: "Les thérapies brèves constituent un accompagnement de mieux-être et de soutien psychologique, mais ne remplacent pas un suivi médical ou psychiatrique. Si votre situation nécessite un accompagnement médical spécifique, je vous orienterai en toute transparence vers les professionnels de santé adaptés."
  },
  {
    question: "Les séances en visioconférence sont-elles aussi efficaces qu'au cabinet ?",
    answer: "Oui, la qualité d'écoute, la présence et les outils thérapeutiques utilisés s'adaptent parfaitement à la visioconférence. Si vous êtes éloigné(e) de Voisins-le-Bretonneux ou en déplacement, la visio offre un cadre tout aussi chaleureux et opérant."
  }
];
---

<Layout 
  title="Thérapies brèves à Voisins-le-Bretonneux (Yvelines) · Anne Chataigner"
  description="Accompagnement bienveillant et concret en thérapies brèves pour apaiser la charge mentale, dépasser un blocage et retrouver un équilibre émotionnel dans les Yvelines."
>
  <Navbar slot="navbar" />

  <main id="main-content">
    <!-- Hero Header Atmosphérique Immersion -->
    <PageHeroAtmospheric 
      badgeText="Thérapies brèves intégratives"
      badgeType="therapies"
      title="Apaiser ce qui pèse et retrouver votre équilibre émotionnel."
      lead="Un accompagnement concret, personnalisé et à votre rythme. Parce qu'il n'est pas nécessaire d'aller mal pour se faire accompagner, les thérapies brèves vous aident à dénouer les tensions, comprendre vos mécanismes et retrouver de la fluidité au quotidien."
      primaryCtaText="Prendre rendez-vous"
      primaryCtaLink="#contact"
      secondaryCtaText="Découvrir les motifs"
      secondaryCtaLink="#reperes"
      scrollTargetId="reperes"
      scrollLabel="Découvrir"
    />

    <!-- Section 1 : Nuage de Situations & Résonance -->
    <SituationCloud 
      subtitle="Votre point de départ"
      title="Des motifs fréquents de consultation au cabinet"
      lead="Chaque accompagnement part de votre vécu singulier, sans protocole figé ni jugement. Voici les difficultés couramment abordées en séance."
      tags={therapiesTags}
      quote="« Écouter ce que vos émotions ont à vous dire sans vous laisser submerger par elles. »"
      sectionId="reperes"
      theme="therapies"
    />

    <!-- Section 2 : Éclairage / Comprendre ce qui se joue -->
    <InsightSection 
      badgeText="Compréhension & Approche"
      badgeType="therapies"
      title="Le 'Comment faire autrement' : Traiter la mécanique du présent"
      lead="Pourquoi ressasser le 'pourquoi' ne suffit-il souvent pas à aller mieux ? Parce que la compréhension intellectuelle d'un problème n'apaise pas automatiquement l'émotion."
      bodyParagraphs={[
        "En thérapies brèves, nous nous concentrons sur la <strong>façon dont le problème se manifeste aujourd'hui</strong> dans votre corps, vos pensées et vos relations. En décryptant les déclencheurs et les schémas réflexes, nous pouvons intervenir directement sur la boucle émotionnelle.",
        "Mon approche associe des outils de <strong>régulation émotionnelle, d'écoute systémique et de recadrage cognitif</strong>. L'objectif n'est pas de refouler ce qui fait mal, mais de permettre à votre système nerveux de digérer l'inconfort et de retrouver son état naturel de sécurité.",
        "Vous redevenez acteur/actrice de votre équilibre : chaque séance apporte un éclairage immédiat et des exercices simples à réutiliser dès que le stress pointe."
      ]}
      highlightBoxTitle="Une approche douce et déculpabilisante"
      highlightBoxText="Vos réactions émotionnelles ne sont pas des anomalies : ce sont des signaux d'alerte que votre organisme a mis en place pour se protéger. Nous apprenons simplement à leur donner une réponse plus douce et adaptée."
      keypoints={[
        { title: "Désactivation du stress aigu", description: "Apaiser les réactions physiques de panique ou de tension." },
        { title: "Recadrage des croyances", description: "Prendre de la distance avec les pensées automatiques dévalorisantes." },
        { title: "Autonomie émotionnelle", description: "Savoir s'apaiser soi-même en toute circonstance." }
      ]}
      sectionId="approche-eclairage"
      bgColor="#ffffff"
    />

    <!-- Section 3 : Déroulement en 4 étapes clés -->
    <ProcessTimeline 
      subtitle="Cadre & Déroulement"
      title="Comment se déroule une consultation ?"
      lead="Chaque séance dure 1 heure et s'organise autour d'un temps d'écoute personnalisée, d'exercices d'apaisement et de repères concrets."
      steps={therapiesSteps}
      pricingBanner={{
        tag: "Modalités & Tarif",
        title: "Consultation individuelle de Thérapie brève",
        description: "Séance d'1 heure au cabinet de Voisins-le-Bretonneux ou en visioconférence. Remise systématique d'une facture pour votre mutuelle.",
        amount: "85 €",
        duration: "Durée : 1 heure",
        linkText: "Consulter tous les tarifs →",
        linkUrl: "/tarifs",
        tagColor: "#2E452A"
      }}
      sectionId="deroulement"
      bgColor="#F6F8F5"
    />

    <!-- Section 4 : Grille des 4 Clés de Transformation -->
    <BenefitGrid 
      subtitle="Bénéfices & Apaisement"
      title="Ce que les thérapies brèves transforment dans votre vie"
      lead="Retrouvez de la clarté d'esprit, du repos et une relation plus sereine avec vous-même et votre entourage."
      cards={therapiesBenefits}
      sectionId="benefices"
    />

    <!-- Section 5 : FAQ Accordéon Détaillée -->
    <FaqAccordion 
      items={therapiesFaq}
      subtitle="Questions fréquentes"
      title="Tout comprendre sur les thérapies brèves"
      badgeType="therapies"
    />

    <!-- Section 6 : Passerelles vers les autres approches -->
    <RelatedServices currentService="therapies" />

    <!-- Section 7 : CTA Final -->
    <InteriorCta 
      title="Envie de retrouver de l'apaisement et de la légèreté ?"
      lead="Prendre rendez-vous est une première démarche bienveillante pour poser ce qui vous encombre et avancer vers un équilibre durable."
      buttonText="Prendre rendez-vous"
    />
  </main>

  <Footer slot="footer" />
</Layout>
