---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeroAtmospheric from '../components/PageHeroAtmospheric.astro';
import SituationCloud from '../components/SituationCloud.astro';
import InsightSection from '../components/InsightSection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import BenefitGrid from '../components/BenefitGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedServices from '../components/RelatedServices.astro';
import InteriorCta from '../components/InteriorCta.astro';

const coupleTags = [
  { text: "Difficultés de communication", color: "amber", size: "lg" },
  { text: "Incompréhensions & malentendus", color: "terracotta", size: "lg" },
  { text: "Arrivée d'un enfant & parentalité", color: "sage", size: "md" },
  { text: "Départ des enfants (nid vide)", color: "blue", size: "md" },
  { text: "Usure du quotidien & routine", color: "slate", size: "md" },
  { text: "Perte de complicité & intimité", color: "rose", size: "lg" },
  { text: "Désaccords sur l'éducation", color: "amber", size: "md" },
  { text: "Tensions financières ou logistiques", color: "slate", size: "sm" },
  { text: "Crise de confiance ou non-dits", color: "terracotta", size: "lg" },
  { text: "Désir de redéfinir le projet de couple", color: "green", size: "md" },
  { text: "Clarification d'une séparation sereine", color: "blue", size: "md" },
  { text: "Partage de la charge mentale", color: "sage", size: "sm" },
  { text: "Transitions professionnelles d'un conjoint", color: "slate", size: "sm" },
  { text: "Cheminer vers ce qui est juste", color: "amber", size: "lg" }
];

const coupleSteps = [
  {
    number: "Étape 01",
    title: "Temps d'expression équitable & apaisé",
    description: "Chaque partenaire dépose sa perception de la situation, ses besoins et ses ressentis sans être interrompu, dans un cadre sécurisé et bienveillant.",
    keypoints: [
      "Parole libre et respectueuse",
      "Écoute sans prise de parti",
      "Identification des motifs réels"
    ],
    badgeBg: "#FAF4E8",
    badgeColor: "#6D4811"
  },
  {
    number: "Étape 02",
    title: "Mettre en lumière les mécanismes relationnels",
    description: "Nous décodons la 'danse relationnelle' : comment les réactions de l'un activent les blessures de l'autre, pour sortir des accusations stériles.",
    keypoints: [
      "Décryptage des cercles vicieux",
      "Différenciation de la personne et du problème",
      "Compréhension des besoins sous-jacents"
    ],
    badgeBg: "#FAF4E8",
    badgeColor: "#6D4811"
  },
  {
    number: "Étape 03",
    title: "Co-construire de nouveaux accords durables",
    description: "Vous élaborez des clés de communication concrètes (CNV), des rituels de connexion et des accords relationnels clairs à tester chez vous.",
    keypoints: [
      "Règles d'écoute et de désescalade",
      "Rituels de reconnexion au quotidien",
      "Clarté sur les décisions à prendre"
    ],
    badgeBg: "#FAF4E8",
    badgeColor: "#6D4811"
  }
];

const coupleBenefits = [
  {
    step: "01",
    title: "Sécurité relationnelle retrouvée",
    description: "Abordez les sujets délicats ou tabous sans craindre que l'échange ne tourne systématiquement au conflit.",
    color: "amber",
    iconType: "shield"
  },
  {
    step: "02",
    title: "Compréhension mutuelle en profondeur",
    description: "Entendez ce que votre partenaire ressent véritablement derrière les reproches ou les silences du quotidien.",
    color: "blue",
    iconType: "heart"
  },
  {
    step: "03",
    title: "Outils de communication concrets",
    description: "Intégrez des réflexes d'expression centrés sur vos besoins plutôt que sur la critique accusatrice.",
    color: "sage",
    iconType: "users"
  },
  {
    step: "04",
    title: "Clarté sur l'avenir du lien",
    description: "Décidez en conscience de ce qui est juste pour chacun : renouveler le pacte de couple ou cheminer sereinement.",
    color: "terracotta",
    iconType: "compass"
  }
];

const coupleFaq = [
  {
    question: "Que faire si mon conjoint ou partenaire hésite à venir consulter ?",
    answer: "Il est très fréquent que l'un des conjoints éprouve des réticences ou craigne d'être mis en accusation. La consultation n'a pas vocation à désigner un « coupable » ni à imposer une issue prédéterminée. C'est avant tout un <strong>espace neutre d'exploration</strong>. Venir pour une première séance sans engagement à long terme permet souvent de dissiper ces appréhensions et de constater le caractère sécurisant du cadre."
  },
  {
    question: "La consultation de couple est-elle réservée aux situations de crise grave ?",
    answer: "Non. Tout comme pour les consultations individuelles, <strong>il n'est pas nécessaire d'attendre la rupture ou l'épuisement pour se faire accompagner</strong>. Consulter lors d'une transition (arrivée d'un enfant, départ à la retraite, changement de rythme) permet de prévenir les incompréhensions, de réajuster le dialogue et de consolider le lien avant que les rancœurs ne s'accumulent."
  },
  {
    question: "L'accompagnement a-t-il pour seul but de 'sauver' le couple ?",
    answer: "L'objectif est d'accompagner les deux partenaires vers <strong>ce qui est juste pour chacun et pour la relation</strong>. Selon votre situation et vos désirs, cela peut signifier retrouver une intimité et une complicité renouvelées, ou bien clarifier une séparation dans le respect mutuel, le calme et la préservation de l'équilibre familial."
  },
  {
    question: "Quelle est la durée et le rythme des séances de couple ?",
    answer: "Les séances de couple durent <strong>1h30</strong>. Ce format spacieux garantit que chaque partenaire dispose d'un temps de parole équitable et que les échanges puissent se déployer sans précipitation. Les séances sont généralement espacées de 3 à 4 semaines pour vous laisser le temps d'expérimenter les nouveaux accords au quotidien."
  },
  {
    question: "Comment garantissez-vous la neutralité durant les échanges ?",
    answer: "Ma posture de thérapeute systémique consiste à me placer au service de la <em>relation</em>, et non d'une personne contre l'autre. Je veille scrupuleusement à l'équilibre des temps de parole, à la reformulation bienveillante et à la protection de l'espace d'échange."
  },
  {
    question: "Est-il possible de faire des séances de couple en visioconférence ?",
    answer: "Oui, la consultation de couple peut tout à fait se dérouler en visioconférence si vous êtes tous les deux réunis devant le même écran, ou même connectés depuis deux endroits différents en cas de déplacement professionnel."
  }
];
---

<Layout 
  title="Consultation de couple à Voisins-le-Bretonneux · Anne Chataigner"
  description="Un espace neutre et bienveillant pour permettre à chaque partenaire de s'exprimer, éclairer ce qui se joue dans la relation et cheminer ensemble."
>
  <Navbar slot="navbar" />

  <main id="main-content">
    <!-- Hero Header Atmosphérique Immersion -->
    <PageHeroAtmospheric 
      badgeText="Accompagnement relationnel & de couple"
      badgeType="couple"
      title="Un espace pour dialoguer, se comprendre et cheminer ensemble."
      lead="Un espace neutre, bienveillant et sécurisant pour permettre à chacun de s’exprimer, mettre en lumière ce qui se joue dans la relation et cheminer ensemble vers ce qui est juste pour soi et pour le couple."
      primaryCtaText="Prendre rendez-vous"
      primaryCtaLink="#contact"
      secondaryCtaText="Découvrir le cadre"
      secondaryCtaLink="#reperes"
      scrollTargetId="reperes"
      scrollLabel="Découvrir"
    />

    <!-- Section 1 : Nuage de Situations Relationnelles -->
    <SituationCloud 
      subtitle="Votre point de départ"
      title="Des moments charnières dans la vie du couple"
      lead="Chaque couple traverse des cycles, des transformations et des remises en question. Voici les situations où un regard extérieur neutre permet de retrouver du souffle."
      tags={coupleTags}
      quote="« Entre ce que je pense, ce que je veux dire, ce que je dis, ce que tu entends, ce que tu veux comprendre et ce que tu comprends, il y a dix possibilités de ne pas s'entendre. »"
      sectionId="reperes"
      theme="couple"
    />

    <!-- Section 2 : Éclairage Systémique & CNV -->
    <InsightSection 
      badgeText="Systémique & Posture"
      badgeType="couple"
      title="Sortir du 'Qui a tort, qui a raison' : Soigner la relation"
      lead="Dans un couple en difficulté, le problème n'est presque jamais l'un des conjoints, mais la dynamique inconsciente qui s'est installée entre eux."
      bodyParagraphs={[
        "En approche systémique, nous considérons le couple comme un organisme vivant. Lorsque la communication s'enraye, chacun a tendance à réagir aux réactions de l'autre : le reproche entraîne le repli, qui suscite davantage de reproches.",
        "Mon rôle en tant que tiers neutre n'est pas de distribuer des bons et des mauvais points, mais de vous aider à <strong>observer ensemble cette mécanique</strong>. En prenant conscience de votre danse relationnelle, vous pouvez cesser de vous attaquer mutuellement pour vous allier contre le problème.",
        "Grâce aux principes de la <strong>Communication Non Violente (CNV)</strong>, nous réapprenons à formuler des demandes claires et concrètes à partir de vos besoins fondamentaux (sécurité, écoute, reconnaissance, liberté)."
      ]}
      highlightBoxTitle="La neutralité bienveillante comme rempart"
      highlightBoxText="Au cabinet, personne n'est jugé ni sommé de changer sous la contrainte. Le cadre garantit que chaque voix compte et que chaque sensibilité est respectée dans son intégrité."
      keypoints={[
        { title: "Désescalade immédiate", description: "Stopper les spirales de reproches et d'incompréhensions mutuelles." },
        { title: "Écoute des besoins réels", description: "Comprendre ce qui se cache derrière les silences ou l'agacement." },
        { title: "Cheminement sur-mesure", description: "Avancer vers ce qui fait sens pour vous, sans décision imposée." }
      ]}
      sectionId="approche-eclairage"
      bgColor="#ffffff"
    />

    <!-- Section 3 : Déroulement de la démarche -->
    <ProcessTimeline 
      subtitle="Cadre & Déroulement"
      title="Le déroulement d'une consultation de couple"
      lead="Des séances de 1h30 pour permettre à chacun de déposer ses ressentis sans précipitation et repartir avec des repères clairs."
      steps={coupleSteps}
      pricingBanner={{
        tag: "Modalités & Tarif",
        title: "Consultation de couple",
        description: "Un espace neutre, bienveillant et sécurisant pour permettre à chacun de s’exprimer, mettre en lumière ce qui se joue dans la relation et cheminer ensemble.",
        amount: "150 €",
        duration: "Durée : 1 h 30",
        linkText: "Consulter tous les tarifs →",
        linkUrl: "/tarifs",
        tagColor: "#6D4811"
      }}
      sectionId="deroulement"
      bgColor="#FAF6F0"
    />

    <!-- Section 4 : Grille des 4 Bénéfices de la Consultation -->
    <BenefitGrid 
      subtitle="Bénéfices & Retrouvailles"
      title="Ce que l'accompagnement de couple permet de réparer"
      lead="Retrouvez un dialogue authentique, un climat de confiance et une sérénité partagée au quotidien."
      cards={coupleBenefits}
      sectionId="benefices"
    />

    <!-- Section 5 : FAQ Accordéon Détaillée -->
    <FaqAccordion 
      items={coupleFaq}
      subtitle="Questions fréquentes"
      title="Tout comprendre sur la consultation de couple"
      badgeType="couple"
    />

    <!-- Section 6 : Passerelles vers les autres approches -->
    <RelatedServices currentService="couple" />

    <!-- Section 7 : CTA Final -->
    <InteriorCta 
      title="Besoin d'un espace pour échanger sereinement ?"
      lead="Prenez rendez-vous au cabinet de Voisins-le-Bretonneux pour ouvrir un nouveau dialogue au sein de votre couple."
      buttonText="Prendre rendez-vous"
    />
  </main>

  <Footer slot="footer" />
</Layout>
