---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { BOOKING_URL } from '../config/site';
---

<Layout 
  title="Anne Chataigner — Coaching · Thérapies brèves · Hypnose Ericksonienne"
  description="Quand la vie change, retrouver un chemin qui vous ressemble. Accompagnements individuels en coaching, thérapies brèves et hypnose Ericksonienne à Voisins-le-Bretonneux."
>
  <Navbar slot="navbar" />

  <main id="main-content">
    <!-- 2. HERO SECTION (FULL COVER WITH BOTTOM-LEFT TYPOGRAPHY) -->
    <section class="section hero-anne-full" id="accueil">
      <div class="w-layout-blockcontainer container w-container">
        <div class="hero-full-content">
          <div class="hero-badge-pill">
            <span class="hero-badge-dot"></span>
            Anne Chataigner · Coaching · Thérapies brèves · Hypnose Ericksonienne
          </div>
          <h1 class="hero-full-title">
            <span class="hero-full-title-line">Coaching, thérapie brève</span>
            <span class="hero-full-title-line">et hypnose ericksonienne</span>
            <span class="hero-full-title-line">dans les Yvelines</span>
          </h1>
          <p class="hero-full-lead">
            Vous traversez une transition, un blocage ou l’envie d’ouvrir un nouveau chapitre ? Je vous accompagne pour comprendre ce qui se joue, mobiliser vos ressources et avancer avec plus de clarté, de sérénité et de confiance.
          </p>
          <div class="hero-full-buttons">
            <a href={BOOKING_URL} data-wf--button--variant="white" class="primary-button w-variant-df50d2b4-2dcf-06cb-393e-886e8cb0681e w-inline-block" data-booking-link>
              <div class="button-text-wrapper">
                <div class="button-text-inner">
                  <div button-text="" class="button-text">Prendre rendez-vous</div>
                  <div button-text="" class="button-text">Prendre rendez-vous</div>
                </div>
              </div>
            </a>
            <a href="#accompagnements" class="primary-button button-hero-secondary w-inline-block">
              <div class="button-text-wrapper">
                <div class="button-text-inner">
                  <div button-text="" class="button-text">Découvrir les accompagnements</div>
                  <div button-text="" class="button-text">Découvrir les accompagnements</div>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Apple Mouse Scroll Indicator (Below Hero Header - Dark Styled on Light Surface) -->
    <div class="hero-scroll-wrapper">
      <a href="#deroulement" class="hero-scroll-indicator dark-mode" aria-label="Faire défiler vers la méthode">
        <span class="apple-mouse-icon">
          <span class="apple-mouse-wheel"></span>
        </span>
        <span class="hero-scroll-label">Découvrir</span>
      </a>
    </div>

    <!-- 2. SECTION MÉTHODE & DÉROULEMENT (ORGANIC STICKY JOURNEY) -->
    <section class="section section-sticky-journey" id="deroulement">
      <div class="w-layout-blockcontainer container w-container">
        <div class="sticky-journey-layout">
          
          <!-- LEFT COLUMN: Sticky Panel & Dynamic Visual Showcase -->
          <div class="sticky-journey-left">
            <div class="sticky-journey-panel">
              <div class="subtitle sticky-journey-subtitle">
                <span class="subtitle-bullet-dot"></span>
                Méthode &amp; Déroulement
              </div>
              <h2 class="heading-2 sticky-journey-title">
                Un accompagnement pour comprendre, mobiliser et avancer.
              </h2>
              <p class="text sticky-journey-lead">
                Un cheminement progressif, feutré et profondément bienveillant en 4 temps clés. Chaque étape s'appuie sur la précédente pour clarifier vos repères et redonner du souffle à votre quotidien.
              </p>

              <!-- Dynamic Visual Showcase (Changes smoothly on scroll) -->
              <div class="sticky-visual-card" id="stickyVisualCard">
                <div class="sticky-visual-glow" id="stickyVisualGlow"></div>
                <div class="sticky-image-container">
                  <img src="/assets/step-1-ecouter.webp" alt="Étape 1 · Écouter" class="sticky-image active" data-img-step="1" />
                  <img src="/assets/step-2-explorer.webp" alt="Étape 2 · Explorer" class="sticky-image" data-img-step="2" />
                  <img src="/assets/step-4-avancer.webp" alt="Étape 3 · Mobiliser" class="sticky-image" data-img-step="3" />
                  <img src="/assets/step-4-avancer.webp" alt="Étape 4 · Avancer" class="sticky-image" data-img-step="4" />
                </div>
                
                <!-- Dynamic Pill Overlay -->
                <div class="sticky-visual-badge" id="stickyVisualBadge">
                  <span class="sticky-visual-dot" id="stickyVisualDot"></span>
                  <span class="sticky-visual-text" id="stickyVisualText">01 · Écouter</span>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Spacious Scrolling Steps with Organic Curved Thread -->
          <div class="sticky-journey-right">
            <div class="sticky-timeline-wrapper">
              
              <!-- Organic Curved SVG Thread with Start & End Caps -->
              <div class="organic-thread-container">
                <svg class="organic-thread-svg" viewBox="0 0 60 2400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="organicJourneyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#8192AC" />
                      <stop offset="33%" stop-color="#A4ACA1" />
                      <stop offset="66%" stop-color="#DFA38B" />
                      <stop offset="100%" stop-color="#EBC284" />
                    </linearGradient>
                    <filter id="organicGlowFilter" x="-30%" y="-30%" width="160%" height="160%">
                      <feGaussianBlur stdDeviation="5" result="blur" />
                      <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                      </feMerge>
                    </filter>
                  </defs>

                  <!-- Background organic guide path -->
                  <path class="organic-path-bg" d="M 30 16 L 30 250 C 30 450, 48 550, 48 600 C 48 650, 30 750, 30 850 C 30 1050, 12 1150, 12 1200 C 12 1250, 30 1350, 30 1450 C 30 1650, 48 1750, 48 1800 C 48 1850, 30 1950, 30 2050 L 30 2384" stroke="rgba(101, 101, 95, 0.16)" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 8" />
                  
                  <!-- Active glowing organic path -->
                  <path id="organicPathActive" class="organic-path-active" d="M 30 16 L 30 250 C 30 450, 48 550, 48 600 C 48 650, 30 750, 30 850 C 30 1050, 12 1150, 12 1200 C 12 1250, 30 1350, 30 1450 C 30 1650, 48 1750, 48 1800 C 48 1850, 30 1950, 30 2050 L 30 2384" stroke="url(#organicJourneyGradient)" stroke-width="4.5" stroke-linecap="round" filter="url(#organicGlowFilter)" />

                  <!-- Point de départ (Haut) : Rond fermé élégant en Bleu ardoise -->
                  <circle cx="30" cy="16" r="10" fill="rgba(129, 146, 172, 0.22)" />
                  <circle cx="30" cy="16" r="5" fill="#8192AC" />
                  <circle cx="30" cy="16" r="2.2" fill="#ffffff" />

                  <!-- Point d'arrivée (Bas) : Rond fermé élégant en Ocre doré -->
                  <circle cx="30" cy="2384" r="10" fill="rgba(235, 194, 132, 0.28)" />
                  <circle cx="30" cy="2384" r="5" fill="#EBC284" />
                  <circle cx="30" cy="2384" r="2.2" fill="#ffffff" />
                </svg>
              </div>

              <!-- 4 Spacious Step Chapters -->
              <div class="sticky-steps-list">
                
                <!-- Step 1: Écouter (Bleu) -->
                <article class="sticky-step-item active" data-step="1" id="step-card-1">
                  <div class="sticky-step-node node--blue">
                    <span class="sticky-node-pulse"></span>
                    <span class="sticky-node-num">01</span>
                  </div>
                  <div class="sticky-step-card card--blue">
                    <div class="sticky-step-badge badge--blue">Étape 1 · Écoute &amp; Accueil</div>
                    <h3 class="sticky-step-heading">Écouter</h3>
                    <p class="sticky-step-mantra">
                      « Prendre le temps de déposer ce qui pèse, dans un espace confidentiel où chaque mot compte. »
                    </p>
                    <p class="sticky-step-description">
                      Comprendre votre demande, accueillir votre histoire, vos émotions et ce que vous traversez dans un cadre d'écoute attentive, chaleureuse et sans jugement.
                    </p>
                    <div class="step-keypoints">
                      <span class="step-keypoint-pill">✓ Cadre confidentiel &amp; sécurisant</span>
                      <span class="step-keypoint-pill">✓ Accueil bienveillant</span>
                      <span class="step-keypoint-pill">✓ Clarification de votre demande</span>
                    </div>
                  </div>
                </article>

                <!-- Step 2: Explorer (Vert) -->
                <article class="sticky-step-item" data-step="2" id="step-card-2">
                  <div class="sticky-step-node node--green">
                    <span class="sticky-node-pulse"></span>
                    <span class="sticky-node-num">02</span>
                  </div>
                  <div class="sticky-step-card card--green">
                    <div class="sticky-step-badge badge--green">Étape 2 · Exploration &amp; Clarification</div>
                    <h3 class="sticky-step-heading">Explorer</h3>
                    <p class="sticky-step-mantra">
                      « Éclairer la dynamique globale : pensées, émotions, corps, relations et parcours. »
                    </p>
                    <p class="sticky-step-description">
                      Prendre en compte vos pensées, vos ressentis corporels, vos relations et votre contexte de vie pour identifier précisément les nœuds et les leviers d'évolution.
                    </p>
                    <div class="step-keypoints">
                      <span class="step-keypoint-pill">✓ Cartographie des blocages</span>
                      <span class="step-keypoint-pill">✓ Écoute des signaux du corps</span>
                      <span class="step-keypoint-pill">✓ Prise de recul lucide</span>
                    </div>
                  </div>
                </article>

                <!-- Step 3: Mobiliser (Rouge / Corail) -->
                <article class="sticky-step-item" data-step="3" id="step-card-3">
                  <div class="sticky-step-node node--coral">
                    <span class="sticky-node-pulse"></span>
                    <span class="sticky-node-num">03</span>
                  </div>
                  <div class="sticky-step-card card--coral">
                    <div class="sticky-step-badge badge--coral">Étape 3 · Mobilisation &amp; Ressources</div>
                    <h3 class="sticky-step-heading">Mobiliser</h3>
                    <p class="sticky-step-mantra">
                      « Réveiller vos ressources profondes déjà présentes et ouvrir de nouveaux chemins. »
                    </p>
                    <p class="sticky-step-description">
                      Retrouver vos ressources profondes déjà présentes, lever les blocages et choisir les approches les plus adaptées (coaching, thérapies brèves, hypnose).
                    </p>
                    <div class="step-keypoints">
                      <span class="step-keypoint-pill">✓ Déverrouillage des freins</span>
                      <span class="step-keypoint-pill">✓ Pratiques intégratives douces</span>
                      <span class="step-keypoint-pill">✓ Reconnexion aux forces intérieures</span>
                    </div>
                  </div>
                </article>

                <!-- Step 4: Avancer (Jaune / Ambre) -->
                <article class="sticky-step-item" data-step="4" id="step-card-4">
                  <div class="sticky-step-node node--amber">
                    <span class="sticky-node-pulse"></span>
                    <span class="sticky-node-num">04</span>
                  </div>
                  <div class="sticky-step-card card--amber">
                    <div class="sticky-step-badge badge--amber">Étape 4 · Action &amp; Alignement</div>
                    <h3 class="sticky-step-heading">Avancer</h3>
                    <p class="sticky-step-mantra">
                      « Construire pas à pas une trajectoire qui vous ressemble et ancrer le renouveau. »
                    </p>
                    <p class="sticky-step-description">
                      Construire pas à pas une manière plus juste d’avancer, ancrer de nouveaux repères et retrouver une direction claire, sereine et confiante, à votre rythme.
                    </p>
                    <div class="step-keypoints">
                      <span class="step-keypoint-pill">✓ Ancrage des apprentissages</span>
                      <span class="step-keypoint-pill">✓ Alignement avec vos valeurs</span>
                      <span class="step-keypoint-pill">✓ Autonomie &amp; sérénité retrouvée</span>
                    </div>
                  </div>
                </article>

              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. SECTION “VOUS TRAVERSEZ PEUT-ÊTRE…” (NUAGES DE MOTS FLOTTANTS SANS CARDS) -->
    <section class="section section-reperes-clouds" id="reperes">
      <div class="w-layout-blockcontainer container w-container">
        
        <!-- Centered Header: Title on 1 single line, lead on max 2 lines -->
        <div class="reperes-header-centered">
          <div class="subtitle reperes-subtitle">
            <span class="subtitle-bullet-dot"></span>
            Votre point de départ
          </div>
          <h2 class="heading-2 reperes-title-single-line">
            Vous traversez peut-être une étape qui demande de nouveaux repères.
          </h2>
          <p class="reperes-lead-two-lines">
            Chaque parcours de vie connaît des moments de bascule. Qu’ils soient désirés ou inattendus, ces passages nous invitent à faire une pause, clarifier nos priorités et retrouver notre équilibre.
          </p>
        </div>

        <!-- Floating Word Clouds Area (Zero cards, 100% organic centered floating tags) -->
        <div class="floating-clouds-wrapper">
          
          <!-- Cloud Cluster 1: Transitions choisies -->
          <div class="floating-cloud-section">
            <div class="floating-cloud-badge badge--chosen">
              01 · Transitions choisies
            </div>
            
            <div class="floating-tags-cloud" aria-label="Nuage de mots transitions choisies">
              <span class="cloud-tag tag-xl tag-color-blue" style="--delay: 0s;">Reconversion professionnelle</span>
              <span class="cloud-tag tag-lg tag-color-green" style="--delay: 0.8s;">Nouveau projet</span>
              <span class="cloud-tag tag-md tag-color-amber" style="--delay: 1.6s;">Premier emploi</span>
              <span class="cloud-tag tag-xl tag-color-sage" style="--delay: 0.4s;">Départ à la retraite</span>
              <span class="cloud-tag tag-sm tag-color-slate" style="--delay: 2.2s;">Études &amp; Orientation</span>
              <span class="cloud-tag tag-lg tag-color-blue" style="--delay: 1.2s;">Naissance &amp; Parentalité</span>
              <span class="cloud-tag tag-md tag-color-coral" style="--delay: 0.6s;">Transmission d’entreprise</span>
              <span class="cloud-tag tag-lg tag-color-amber" style="--delay: 1.9s;">Prise de responsabilités</span>
              <span class="cloud-tag tag-sm tag-color-green" style="--delay: 1.4s;">Déménagement</span>
              <span class="cloud-tag tag-md tag-color-slate" style="--delay: 0.3s;">Désir d’alignement</span>
              <span class="cloud-tag tag-lg tag-color-sage" style="--delay: 2.5s;">Création d'activité</span>
              <span class="cloud-tag tag-sm tag-color-blue" style="--delay: 1.7s;">Épanouissement personnel</span>
            </div>
          </div>

          <!-- Cloud Cluster 2: Transitions subies -->
          <div class="floating-cloud-section">
            <div class="floating-cloud-badge badge--unplanned">
              02 · Transitions subies
            </div>
            
            <div class="floating-tags-cloud" aria-label="Nuage de mots transitions subies">
              <span class="cloud-tag tag-xl tag-color-coral" style="--delay: 0.2s;">Burn-out &amp; Épuisement</span>
              <span class="cloud-tag tag-lg tag-color-terracotta" style="--delay: 1.1s;">Perte de confiance en soi</span>
              <span class="cloud-tag tag-md tag-color-amber" style="--delay: 0.5s;">Période de stress</span>
              <span class="cloud-tag tag-xl tag-color-slate" style="--delay: 1.8s;">Surcharge mentale</span>
              <span class="cloud-tag tag-md tag-color-rose" style="--delay: 2.3s;">Séparation &amp; Rupture</span>
              <span class="cloud-tag tag-lg tag-color-coral" style="--delay: 0.9s;">Deuil &amp; Perte</span>
              <span class="cloud-tag tag-sm tag-color-terracotta" style="--delay: 1.5s;">Difficulté relationnelle</span>
              <span class="cloud-tag tag-lg tag-color-amber" style="--delay: 0.7s;">Licenciement</span>
              <span class="cloud-tag tag-md tag-color-slate" style="--delay: 2.0s;">Crise de sens</span>
              <span class="cloud-tag tag-sm tag-color-rose" style="--delay: 1.3s;">Isolement &amp; Doute</span>
              <span class="cloud-tag tag-lg tag-color-coral" style="--delay: 2.7s;">Changements imprévus</span>
              <span class="cloud-tag tag-sm tag-color-amber" style="--delay: 0.4s;">Fatigue émotionnelle</span>
            </div>
          </div>

        </div>

        <!-- Centered Luxury Conclusion Pill -->
        <div class="reperes-conclusion-card">
          <div class="reperes-conclusion-icon">✦</div>
          <p class="reperes-conclusion-text">
            Toutes ces étapes ont un point commun : elles nous invitent à redéfinir nos repères, à mobiliser de nouvelles ressources et à trouver une manière plus juste d’avancer.
          </p>
        </div>

      </div>
    </section>

    <!-- 4. SECTION “IL N’EST PAS NÉCESSAIRE D’ALLER MAL…” (MODERNE AVEC IMAGE & MICRO-CARDS) -->
    <section class="section section-pas-de-cote" id="benefices">
      <div class="w-layout-blockcontainer container w-container">
        <div class="pas-de-cote-wrapper">
          
          <!-- LEFT COLUMN: Content & Interactive Benefits -->
          <div class="pas-de-cote-content">
            <div class="pas-de-cote-badge">
              <span class="pas-de-cote-badge-dot"></span>
              Faire un pas de côté
            </div>
            
            <h2 class="heading-2 pas-de-cote-title">
              Il n’est pas nécessaire d’aller mal pour avoir envie d’aller mieux.
            </h2>
            
            <p class="pas-de-cote-lead">
              Un accompagnement peut aider à traverser une difficulté, mais aussi à préparer une nouvelle étape, prendre une décision, développer son potentiel ou ouvrir un nouveau chapitre de vie.
            </p>

            <!-- 8 Interactive Modern Benefits Pills -->
            <div class="pas-de-cote-grid">
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Mieux comprendre ce qui se joue</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Accueillir et réguler ses émotions</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Retrouver confiance en soi</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Dépasser un blocage</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Clarifier une décision importante</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Préparer une transition</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Retrouver du sens et de l'élan</span>
              </div>
              
              <div class="pas-de-cote-item">
                <div class="pas-de-cote-item-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span>Avancer avec plus de fluidité</span>
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pas-de-cote-cta">
              <a href={BOOKING_URL} data-wf--button--variant="primary" class="primary-button w-inline-block" data-booking-link>
                <div class="button-text-wrapper">
                  <div class="button-text-inner">
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                  </div>
                </div>
              </a>
            </div>
          </div>

          <!-- RIGHT COLUMN: Visual Showcase with Couple Therapy Image -->
          <div class="pas-de-cote-visual">
            <div class="pas-de-cote-image-card">
              <div class="pas-de-cote-image-wrapper">
                <img loading="lazy" src="/assets/couple%20therapie.webp" alt="Séance d'accompagnement et thérapie en cabinet - Anne Chataigner" class="pas-de-cote-img"/>
              </div>
              
              <!-- Floating Glassmorphic Badge -->
              <div class="pas-de-cote-floating-badge">
                <div class="pas-de-cote-floating-badge-glow"></div>
                <div class="pas-de-cote-floating-badge-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="pas-de-cote-floating-badge-text">
                  <span class="pas-de-cote-floating-badge-title">Cadre sécurisant &amp; confidentiel</span>
                  <span class="pas-de-cote-floating-badge-sub">Pour déposer, clarifier et avancer ensemble</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 5. SECTION DES TROIS ACCOMPAGNEMENTS (100% IMAGE EN FOND AVEC TEXTE EN OVERLAY) -->
    <section class="section" id="accompagnements">
      <div class="w-layout-blockcontainer container w-container">
        <div class="vertical-wrapper">
          <div class="vertical-headline program-heading-home-b">
            <div class="subtitle">Les accompagnements</div>
            <h2 class="heading-2">
              Trois portes d’entrée, une même intention : vous aider à avancer.
            </h2>
          </div>

          <div class="three-programs-grid">
            <!-- Bloc 1 : Coaching -->
            <a href="/coaching" class="program-card-modern program-card-modern--coaching">
              <div class="program-card-bg-wrapper">
                <img loading="lazy" src="/assets/step-1-ecouter.webp" alt="Accompagnement en Coaching - Anne Chataigner" class="program-card-bg-img"/>
                <div class="program-card-gradient-overlay"></div>
