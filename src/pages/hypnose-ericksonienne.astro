---

<Layout 
  title="Hypnose Ericksonienne à Voisins-le-Bretonneux · Anne Chataigner"
  description="Séances d'hypnose ericksonienne dans les Yvelines pour mobiliser vos ressources inconscientes, libérer les blocages et dépasser les automatismes limitants."
>
  <Navbar variant="home" slot="navbar" />

  <main id="main-content" class="ac-page--hypnose">
    <HypnoseHero />

    <HypnoseSituations tags={hypnoseTags} />

    <HypnosePyramidDiagram />

    <HypnoseMethod
      steps={hypnoseSteps}
      pricingBanner={{
        title: "Séance d'Hypnose Ericksonienne",
        description: "Un questionnaire préparatoire en amont, un temps d'échange pour préciser votre demande, une séquence d'hypnose personnalisée et un temps de retour en fin de séance.",
        amount: "110 €",
        duration: "Durée : 1 h 15",
        linkText: "Consulter tous les tarifs",
        linkUrl: "/tarifs"
      }}
    />

    <HypnoseBenefits cards={hypnoseBenefits} />

    <FaqAccordion 
      items={hypnoseFaq}
      subtitle="Questions fréquentes"
      title="Tout ce que vous devez savoir sur l'hypnose."
      badgeType="hypnose"
      variant="home"
    />

    <HypnoseNextSteps />

    <HypnoseCta />
  </main>

  <Footer variant="home" slot="footer" />
</Layout>

<script is:inline src="/assets/js/lenis.min.js"></script>
<script is:inline>
  (() => {
    const page = document.querySelector('.ac-page--hypnose');
    if (!page) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis = null;

    if (!reduceMotion && typeof window.Lenis !== 'undefined') {
      lenis = new window.Lenis({
        duration: 1.12,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.15
      });

      const raf = (time) => {
        lenis.raf(time);
        window.requestAnimationFrame(raf);
      };
      window.requestAnimationFrame(raf);
    }

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          event.preventDefault();
          if (lenis) {
            lenis.scrollTo(target, { offset: -30, duration: 1.2 });
          } else {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll('[data-coaching-reveal]').forEach((el) => {
      observer.observe(el);
    });
  })();
</script>
