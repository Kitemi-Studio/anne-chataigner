---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedServices from '../components/RelatedServices.astro';
import InteriorCta from '../components/InteriorCta.astro';

const hypnoseFaq = [
  {
    question: "L'hypnose implique-t-elle une perte de contrôle ?",
    answer: "<strong>Absolument pas.</strong> Très loin des clichés de l'hypnose de spectacle, l'hypnose Ericksonienne est une approche thérapeutique collaborative, douce et respectueuse. Vous restez parfaitement conscient(e) de tout ce qui se dit et de tout ce qui se passe durant la séance. Vous gardez votre libre arbitre et votre sécurité intérieure à chaque instant."
  },
  {
    question: "Est-ce que tout le monde est réceptif à l'hypnose Ericksonienne ?",
    answer: "Oui, car l'état hypnotique (ou transe naturelle) est un état physiologique que nous expérimentons tous spontanément chaque jour : lorsque vous êtes absorbé(e) par la lecture d'un livre, plongé(e) dans vos pensées au volant ou bercé(e) par un paysage. L'accompagnement consiste simplement à guider cet état naturel pour le mettre au service de votre objectif de changement."
  },
  {
    question: "Comment se prépare la séance avec le questionnaire préalable ?",
    answer: "Avant notre rendez-vous, je vous transmets un <strong>court questionnaire préparatoire</strong>. Ce temps de réflexion personnelle en amont vous permet de poser vos attentes, d'identifier ce que vous souhaitez faire évoluer et me permet de préparer une séance sur-mesure dès votre arrivée."
  },
  {
    question: "Combien de séances d'hypnose sont nécessaires ?",
    answer: "L'hypnose Ericksonienne s'inscrit dans les thérapies brèves. Souvent, <strong>2 à 5 séances</strong> suffisent pour lever un blocage, ancrer un nouveau réflexe ou dépasser un automatisme limitant. Chaque séance permet une intégration progressive et naturelle."
  }
];
---

<Layout 
  title="Hypnose Ericksonienne à Voisins-le-Bretonneux · Anne Chataigner"
  description="Séances d'hypnose ericksonienne dans les Yvelines pour mobiliser vos ressources inconscientes, lever des freins et ouvrir de nouvelles possibilités."
>
  <Navbar slot="navbar" />

  <main id="main-content">
    <!-- Hero Section -->
    <PageHero 
      badgeText="Hypnose Ericksonienne thérapeutique"
      badgeType="hypnose"
      title="Mobiliser vos ressources profondes pour libérer le changement."
      lead="Une méthode douce, respectueuse et collaborative pour accéder à vos potentiels inconscients, dépasser des automatismes limitants et ouvrir de nouvelles perspectives de mieux-être."
      primaryCtaText="Prendre rendez-vous"
      primaryCtaLink="#contact"
      secondaryCtaText="Découvrir le déroulement"
      secondaryCtaLink="#deroulement"
    />

    <!-- Section 1 : Pédagogie & Situations -->
    <section class="section interior-section" id="comprendre">
      <div class="w-layout-blockcontainer container w-container">
        <div class="interior-section-header">
          <div class="interior-section-subtitle" style="color: #8A4027;">
            <span class="subtitle-bullet-dot" style="background: #DFA38B;"></span>
            <span>Comprendre l'approche</span>
          </div>
          <h2 class="interior-section-title">Qu'est-ce que l'hypnose Ericksonienne ?</h2>
          <p class="interior-section-lead">
            Loin des représentations magiques ou autoritaires, l'hypnose Ericksonienne est un état d'attention focalisée et de profonde relaxation, propice à la créativité et à la réorganisation bienveillante de vos mécanismes intérieurs.
          </p>
        </div>

        <div class="situations-grid">
          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--terracotta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="situation-card-title">Gestion du stress &amp; Anxiété</h3>
            <p class="situation-card-text">
              Apaiser les tensions corporelles et émotionnelles, calmer le système nerveux et retrouver une sensation d'espace et de sécurité intérieure.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--terracotta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </div>
            <h3 class="situation-card-title">Sommeil &amp; Récupération</h3>
            <p class="situation-card-text">
              Faciliter l'endormissement, désamorcer l'hyper-vigilance nocturne et réapprendre à votre corps le relâchement réparateur.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--terracotta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24M14.83 14.83l4.24 4.24M14.83 9.17l4.24-4.24M4.93 19.07l4.24-4.24"/></svg>
            </div>
            <h3 class="situation-card-title">Automatismes &amp; Habitudes</h3>
            <p class="situation-card-text">
              Transformer les comportements compulsifs, les grignotages émotionnels ou les schémas répétitifs dont la volonté seule ne vient pas à bout.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--terracotta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3 class="situation-card-title">Confiance &amp; Prise de parole</h3>
            <p class="situation-card-text">
              Désactiver le trac paralysant, renforcer l'assurance, libérer votre voix et aborder les situations d'exposition avec calme et légitimité.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--terracotta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <h3 class="situation-card-title">Phobies &amp; Peurs ciblées</h3>
            <p class="situation-card-text">
              Retraiter les peurs envahissantes (avion, transports, claustrophobie, animaux) en reprogrammant une réponse émotionnelle sereine.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--terracotta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <h3 class="situation-card-title">Transitions de vie &amp; Deuils</h3>
            <p class="situation-card-text">
              Accompagner les étapes de séparation, de départ ou de changement important en mobilisant vos ressources d'adaptation et de résilience.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2 : Déroulement en 4 étapes clés -->
    <section class="section interior-section" id="deroulement" style="background-color: #FAF5F2;">
      <div class="w-layout-blockcontainer container w-container">
        <div class="interior-section-header">
          <div class="interior-section-subtitle" style="color: #8A4027;">
            <span class="subtitle-bullet-dot" style="background: #DFA38B;"></span>
            <span>Protocole &amp; Déroulement</span>
          </div>
          <h2 class="interior-section-title">Comment se déroule une séance d'hypnose ?</h2>
          <p class="interior-section-lead">
            Chaque séance dure 1h15 et suit un déroulé structuré en 4 temps, garantissant un cadre sécurisant et sur-mesure.
          </p>
        </div>

        <div class="steps-cards-grid">
          <!-- Step 1 -->
          <div class="step-box-card">
            <div class="step-box-header">
              <span class="step-box-number" style="background: #FAF1EC; color: #78321A;">01 · En amont</span>
            </div>
            <h3 class="step-box-title">Questionnaire préparatoire</h3>
            <p class="step-box-text">
              Un questionnaire transmis avant notre rendez-vous pour préciser vos attentes, vos ressentis et me permettre de construire une séance entièrement personnalisée.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="step-box-card">
            <div class="step-box-header">
              <span class="step-box-number" style="background: #FAF1EC; color: #78321A;">02 · Échange</span>
            </div>
            <h3 class="step-box-title">Temps d'échange &amp; Précision</h3>
            <p class="step-box-text">
              En début de séance, nous clarifions votre demande, répondons à vos éventuelles questions et définissons ensemble l'objectif précis de la séance.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="step-box-card">
            <div class="step-box-header">
              <span class="step-box-number" style="background: #FAF1EC; color: #78321A;">03 · Hypnose</span>
            </div>
            <h3 class="step-box-title">Séquence d'hypnose guidée</h3>
            <p class="step-box-text">
              Guidé(e) par ma voix dans un état de profonde relaxation consciente, vous explorez vos métaphores et mobilisez vos ressources intérieures en toute sérénité.
            </p>
          </div>

          <!-- Step 4 -->
          <div class="step-box-card">
            <div class="step-box-header">
              <span class="step-box-number" style="background: #FAF1EC; color: #78321A;">04 · Retour</span>
            </div>
            <h3 class="step-box-title">Temps de retour &amp; Intégration</h3>
            <p class="step-box-text">
              Un retour en douceur à votre état de veille ordinaire, suivi d'un court échange pour partager vos impressions et laisser le travail s'intégrer naturellement.
            </p>
          </div>
        </div>

        <!-- Encart Tarifaire Hypnose -->
        <div class="pricing-banner-card">
          <div class="pricing-banner-info">
            <div class="pricing-banner-tag" style="color: #78321A;">Modalités &amp; Tarif</div>
            <h3 class="pricing-banner-title">Séance d'Hypnose Ericksonienne</h3>
            <p class="pricing-banner-desc">
              Un questionnaire préparatoire en amont, un temps d'échange pour préciser votre demande, une séquence d'hypnose personnalisée et un temps de retour en fin de séance.
            </p>
          </div>
          <div class="pricing-banner-action">
            <div class="pricing-banner-amount">110 €</div>
            <div class="pricing-banner-duration">Durée : 1 h 15</div>
            <a href="/tarifs" class="text-link" style="margin-top: 4px; font-size: 14px; font-weight: 600; color: #78321A;">Consulter tous les tarifs →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <FaqAccordion 
      items={hypnoseFaq}
      subtitle="Questions fréquentes"
      title="Tout comprendre sur l'hypnose Ericksonienne"
      badgeType="hypnose"
    />

    <!-- Related Services -->
    <RelatedServices currentService="hypnose" />

    <!-- Interior CTA -->
    <InteriorCta 
      title="Prêt(e) à ouvrir de nouvelles possibilités ?"
      lead="Réservez votre séance au cabinet de Voisins-le-Bretonneux ou contactez-moi pour toute question préalable."
      buttonText="Prendre rendez-vous"
    />
  </main>

  <Footer slot="footer" />
</Layout>
