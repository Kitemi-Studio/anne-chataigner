---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TarifsHero from '../components/TarifsHero.astro';
import TarifsGridList from '../components/TarifsGridList.astro';
import TarifsModalities from '../components/TarifsModalities.astro';
import TarifsFaqAndCta from '../components/TarifsFaqAndCta.astro';

const tarifsFaq = [
  {
    question: "Les consultations sont-elles remboursées par la Sécurité Sociale ?",
    answer: "Non, ces consultations ne relèvent pas du régime obligatoire de l'Assurance Maladie. En revanche, de très nombreuses <strong>mutuelles et assurances complémentaires santé</strong> remboursent les séances de coaching, de thérapies brèves et d'hypnose dans le cadre de leurs forfaits annuels « médecines douces &amp; bien-être ». Une facture acquittée vous est systématiquement remise après chaque rendez-vous."
  },
  {
    question: "Quels sont les moyens de paiement acceptés ?",
    answer: "Au cabinet de Voisins-le-Bretonneux, vous pouvez régler par <strong>chèque, espèces ou virement bancaire</strong> à la fin de la séance. Pour les consultations réalisées à distance en visioconférence, le règlement s'effectue par virement bancaire en amont du rendez-vous."
  },
  {
    question: "Quelle est la politique d'annulation ou de report ?",
    answer: "Afin de respecter le temps de chacun et de permettre à d'autres personnes de bénéficier des créneaux libérés, tout rendez-vous peut être annulé ou reporté sans frais <strong>jusqu'à 48 heures à l'avance</strong>. Passé ce délai, la séance reste due."
  },
  {
    question: "Les tarifs sont-ils les mêmes au cabinet et en visioconférence ?",
    answer: "Oui, les tarifs et les durées sont rigoureusement identiques, que vous consultiez au cabinet de Voisins-le-Bretonneux ou à distance en visioconférence."
  },
  {
    question: "Dois-je m'engager sur un nombre de séances à l'avance ?",
    answer: "Non, vous ne vous engagez jamais sur un forfait bloqué. Vous restez totalement libre de fixer le rythme des séances et de décider quand vous souhaitez clôturer votre accompagnement dès que vous constatez le mieux-être souhaité."
  }
];
---

<Layout 
  title="Tarifs des consultations & séances · Anne Chataigner"
  description="Consultez les tarifs clairs des consultations individuelles (85 € · 1h), séances d'hypnose (110 € · 1h15) et consultations de couple (150 € · 1h30) à Voisins-le-Bretonneux et en visio."
>
  <Navbar variant="home" slot="navbar" />

  <main id="main-content" class="ac-page--tarifs">
    <TarifsHero />
    <TarifsGridList />
    <TarifsModalities />
    <TarifsFaqAndCta faqItems={tarifsFaq} />
  </main>

  <Footer variant="home" slot="footer" />
</Layout>

<script is:inline src="/assets/js/lenis.min.js"></script>
<script is:inline>
  (() => {
    const page = document.querySelector('.ac-page--tarifs');
    if (!page) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis = null;

    if (!reduceMotion && typeof window.Lenis !== 'undefined') {
      lenis = new window.Lenis({
        duration: 1.12,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.15
      });

      const raf = (time) => {
        lenis.raf(time);
        window.requestAnimationFrame(raf);
      };
      window.requestAnimationFrame(raf);
    }

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          event.preventDefault();
          if (lenis) {
            lenis.scrollTo(target, { offset: -30, duration: 1.2 });
          } else {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('[data-coaching-reveal]').forEach((el) => {
      observer.observe(el);
    });
  })();
</script>
