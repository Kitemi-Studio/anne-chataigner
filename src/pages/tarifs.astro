---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeroAtmospheric from '../components/PageHeroAtmospheric.astro';
import SituationCloud from '../components/SituationCloud.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import InteriorCta from '../components/InteriorCta.astro';

const tarifsTags = [
  { text: "Tarifs clairs & transparents", color: "blue", size: "lg" },
  { text: "Consultation individuelle · 85 €", color: "sage", size: "lg" },
  { text: "Séance d'hypnose 1h15 · 110 €", color: "terracotta", size: "lg" },
  { text: "Consultation couple 1h30 · 150 €", color: "amber", size: "lg" },
  { text: "Prise en charge mutuelle médecines douces", color: "green", size: "md" },
  { text: "Facture acquittée systématique", color: "blue", size: "md" },
  { text: "Cabinet à Voisins-le-Bretonneux", color: "slate", size: "md" },
  { text: "Séances également en visio", color: "slate", size: "sm" },
  { text: "Paiement chèque, espèces ou virement", color: "sage", size: "md" },
  { text: "Politique d'annulation sans frais 48h", color: "terracotta", size: "md" },
  { text: "Cadre confidentiel & sécurisant", color: "blue", size: "lg" },
  { text: "Aucun engagement de durée forcé", color: "green", size: "sm" }
];

const tarifsFaq = [
  {
    question: "Les consultations sont-elles remboursées par la Sécurité Sociale ?",
    answer: "Non, ces consultations ne relèvent pas du régime obligatoire de l'Assurance Maladie. En revanche, de très nombreuses <strong>mutuelles et assurances complémentaires santé</strong> remboursent les séances de médecines douces, d'hypnose et de thérapies brèves dans le cadre de forfaits annuels dédiés. Une facture acquittée vous est systématiquement remise après chaque rendez-vous."
  },
  {
    question: "Quels sont les moyens de paiement acceptés ?",
    answer: "Au cabinet de Voisins-le-Bretonneux, vous pouvez régler par <strong>chèque, espèces ou virement bancaire</strong> à la fin de la séance. Pour les consultations réalisées à distance en visioconférence, le règlement s'effectue par virement bancaire sécurisé en amont du rendez-vous."
  },
  {
    question: "Quelle est la politique d'annulation ou de report ?",
    answer: "Afin de respecter le temps de chacun et de permettre à d'autres personnes de bénéficier des créneaux libérés, tout rendez-vous peut être annulé ou reporté sans frais <strong>jusqu'à 48 heures à l'avance</strong>. Passé ce délai de 48 heures, la séance reste due."
  },
  {
    question: "Les tarifs sont-ils les mêmes au cabinet et en visioconférence ?",
    answer: "Oui, les tarifs et les durées sont rigoureusement identiques, que vous consultiez au cabinet de Voisins-le-Bretonneux ou à distance en visioconférence."
  },
  {
    question: "Dois-je m'engager sur un nombre de séances à l'avance ?",
    answer: "Non, vous ne vous engagez jamais sur un forfait bloqué. Vous restez totalement libre de fixer le rythme des séances et de décider quand vous souhaitez clôturer votre accompagnement dès que vous constatez le mieux-être souhaité."
  }
];
---

<Layout 
  title="Tarifs des consultations & séances · Anne Chataigner"
  description="Consultez les tarifs des consultations individuelles (85 €), séances d'hypnose (110 €) et consultations de couple (150 €) au cabinet de Voisins-le-Bretonneux et en visio."
>
  <Navbar slot="navbar" />

  <main id="main-content">
    <!-- Hero Header Atmosphérique Immersion -->
    <PageHeroAtmospheric 
      badgeText="Transparence & Modalités"
      badgeType="pricing"
      title="Tarifs des consultations & séances"
      lead="Une politique tarifaire claire, fixe et sans surprise pour chaque format d'accompagnement au cabinet de Voisins-le-Bretonneux ou à distance en visioconférence."
      primaryCtaText="Prendre rendez-vous"
      primaryCtaLink="#contact"
      secondaryCtaText="Voir la grille"
      secondaryCtaLink="#reperes"
      scrollTargetId="reperes"
      scrollLabel="Découvrir"
    />

    <!-- Section 1 : Nuage de Mots / Repères Tarifs -->
    <SituationCloud 
      subtitle="Transparence & Engagements"
      title="Un cadre financier clair et prévisible"
      lead="Chaque formule est pensée pour offrir un temps d'écoute confortable, structuré et propice à une intégration en profondeur."
      tags={tarifsTags}
      quote="« La clarté du cadre est le premier garant d'une relation thérapeutique de confiance. »"
      sectionId="reperes"
      theme="pricing"
    />

    <!-- Section 2 : Grille des 3 Cartes Tarifaires -->
    <section class="section interior-section" id="grille-tarifs" style="background-color: #ffffff;">
      <div class="w-layout-blockcontainer container w-container">
        <div class="interior-section-header">
          <div class="interior-section-subtitle">
            <span class="subtitle-bullet-dot"></span>
            <span>Grille des formules</span>
          </div>
          <h2 class="interior-section-title">Trois formules d'accompagnement sur-mesure</h2>
          <p class="interior-section-lead">
            Choisissez le format adapté à votre besoin ou échangeons lors de votre première prise de contact pour vous orienter.
          </p>
        </div>

        <div class="pricing-grid-three">
          <!-- Carte 1 : Consultation Individuelle -->
          <div class="pricing-main-card">
            <span class="pricing-card-badge interior-badge--coaching">
              Coaching &amp; Thérapies brèves
            </span>
            <h3 class="pricing-card-title">Consultation individuelle</h3>
            
            <div class="pricing-card-price-row">
              <span class="pricing-card-price">85 €</span>
              <span class="pricing-card-duration">/ séance d'1h</span>
            </div>

            <p class="pricing-card-copy">
              Un temps d’échange pour clarifier votre situation et ce que vous souhaitez faire évoluer, puis un accompagnement adapté à vos besoins, mobilisant les thérapies brèves, le coaching et différents outils thérapeutiques.
            </p>

            <div class="pricing-card-action">
              <a href="#contact" data-wf--button--variant="primary" class="primary-button w-inline-block" data-cal-link data-cal-placeholder="URL Cal.com à renseigner">
                <div class="button-text-wrapper">
                  <div class="button-text-inner">
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                  </div>
                </div>
              </a>
              <a href="/coaching" class="pricing-card-link">Découvrir le coaching &amp; thérapies →</a>
            </div>
          </div>

          <!-- Carte 2 : Séance d'hypnose (Featured) -->
          <div class="pricing-main-card pricing-main-card--featured">
            <span class="pricing-card-badge interior-badge--hypnose">
              Hypnose Ericksonienne
            </span>
            <h3 class="pricing-card-title">Séance d’hypnose</h3>
            
            <div class="pricing-card-price-row">
              <span class="pricing-card-price">110 €</span>
              <span class="pricing-card-duration">/ séance d'1h15</span>
            </div>

            <p class="pricing-card-copy">
              Un questionnaire préparatoire en amont, un temps d’échange pour préciser votre demande, une séquence d’hypnose personnalisée et un temps de retour en fin de séance.
            </p>

            <div class="pricing-card-action">
              <a href="#contact" data-wf--button--variant="primary" class="primary-button w-inline-block" data-cal-link data-cal-placeholder="URL Cal.com à renseigner">
                <div class="button-text-wrapper">
                  <div class="button-text-inner">
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                  </div>
                </div>
              </a>
              <a href="/hypnose-ericksonienne" class="pricing-card-link">Découvrir l'hypnose →</a>
            </div>
          </div>

          <!-- Carte 3 : Consultation de couple -->
          <div class="pricing-main-card">
            <span class="pricing-card-badge interior-badge--couple">
              Relation &amp; Couple
            </span>
            <h3 class="pricing-card-title">Consultation de couple</h3>
            
            <div class="pricing-card-price-row">
              <span class="pricing-card-price">150 €</span>
              <span class="pricing-card-duration">/ séance d'1h30</span>
            </div>

            <p class="pricing-card-copy">
              Un espace neutre, bienveillant et sécurisant pour permettre à chacun de s’exprimer, mettre en lumière ce qui se joue dans la relation et cheminer ensemble vers ce qui est juste pour soi et pour le couple.
            </p>

            <div class="pricing-card-action">
              <a href="#contact" data-wf--button--variant="primary" class="primary-button w-inline-block" data-cal-link data-cal-placeholder="URL Cal.com à renseigner">
                <div class="button-text-wrapper">
                  <div class="button-text-inner">
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                    <div button-text="" class="button-text">Prendre rendez-vous</div>
                  </div>
                </div>
              </a>
              <a href="/consultation-couple" class="pricing-card-link">Découvrir l'accompagnement couple →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3 : Prise en charge Mutuelle & Modalités Pratiques -->
    <section class="section interior-section" style="background-color: #F8FAFC;">
      <div class="w-layout-blockcontainer container w-container">
        <div class="interior-section-header">
          <div class="interior-section-subtitle">
            <span class="subtitle-bullet-dot"></span>
            <span>Remboursements &amp; Cadre</span>
          </div>
          <h2 class="interior-section-title">Modalités de prise en charge</h2>
        </div>

        <div class="situations-grid">
          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3 class="situation-card-title">Forfaits Mutuelles &amp; Facture</h3>
            <p class="situation-card-text">
              Une facture détaillée acquittée vous est remise à chaque consultation pour obtenir le remboursement de votre mutuelle au titre des forfaits médecines douces.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <h3 class="situation-card-title">Cabinet &amp; Visioconférence</h3>
            <p class="situation-card-text">
              Au cabinet au 2 Rue de la Bergerie à Voisins-le-Bretonneux (78960) ou à distance en visio via un lien sécurisé avec la même qualité d'écoute.
            </p>
          </div>

          <div class="situation-card">
            <div class="situation-card-icon situation-card-icon--blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="situation-card-title">Annulation sans frais 48h</h3>
            <p class="situation-card-text">
              Vous pouvez déplacer ou annuler votre séance sans frais jusqu'à 48 heures à l'avance, pour permettre une organisation respectueuse de chacun.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <FaqAccordion 
      items={tarifsFaq}
      subtitle="Questions fréquentes"
      title="Questions sur les tarifs &amp; règlements"
      badgeType="pricing"
    />

    <!-- Interior CTA -->
    <InteriorCta 
      title="Prêt(e) à démarrer votre accompagnement ?"
      lead="Réservez votre créneau en ligne ou contactez-moi directement si vous souhaitez échanger avant de fixer votre premier rendez-vous."
      buttonText="Prendre rendez-vous"
    />
  </main>

  <Footer slot="footer" />
</Layout>
