---

<section class="section contact-practical-info" id="reperes" aria-label="Informations pratiques et accès">
  <div class="w-layout-blockcontainer container w-container">
    <div class="contact-info-strip" data-coaching-reveal>
      
      <!-- Item 01 : Le cabinet -->
      <div class="contact-info-item">
        <div class="contact-info-item__icon-wrap" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <div class="contact-info-item__content">
          <span class="contact-info-item__tag">Lieu de consultation</span>
          <h2 class="contact-info-item__title">Le cabinet</h2>
          <p class="contact-info-item__text">
            2 Rue de la Bergerie, 78960 Voisins-le-Bretonneux<br />
            <span class="contact-info-item__subtext">Yvelines · Saint-Quentin-en-Yvelines</span>
          </p>
        </div>
      </div>

      <div class="contact-info-strip__divider" aria-hidden="true"></div>

      <!-- Item 02 : À distance -->
      <div class="contact-info-item">
        <div class="contact-info-item__icon-wrap" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
        </div>
        <div class="contact-info-item__content">
          <span class="contact-info-item__tag">En ligne</span>
          <h2 class="contact-info-item__title">À distance</h2>
          <p class="contact-info-item__text">
            Les séances sont également assurées en visioconférence sécurisée avec la même qualité de présence.
          </p>
        </div>
      </div>

      <div class="contact-info-strip__divider" aria-hidden="true"></div>

      <!-- Item 03 : Réservation -->
      <div class="contact-info-item">
        <div class="contact-info-item__icon-wrap" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div class="contact-info-item__content">
          <span class="contact-info-item__tag">Prise de créneau</span>
          <h2 class="contact-info-item__title">Réservation directe</h2>
          <p class="contact-info-item__text">
            Possibilité de réserver directement votre premier rendez-vous via l'agenda en ligne.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
