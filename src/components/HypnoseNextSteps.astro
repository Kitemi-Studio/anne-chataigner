---
interface Props {
  sectionId?: string;
}

const { sectionId = 'suite' } = Astro.props;
---

<section class="section coaching-next-steps hypnose-next-steps" id={sectionId}>
  <div class="w-layout-blockcontainer container w-container">
    <div class="vertical-wrapper">
      <div class="vertical-headline program-heading-home-b" data-coaching-reveal>
        <div class="subtitle">Pour aller plus loin</div>
        <h2 class="heading-2">Une approche ajustée à ce que vous traversez.</h2>
      </div>

      <div class="three-programs-grid coaching-next-steps__grid">
        <a href="/coaching" class="program-card-modern" data-coaching-reveal>
          <div class="program-card-bg-wrapper">
            <img loading="lazy" src="/assets/step-1-ecouter%20-%20nouveau%20bureau.png" alt="Coaching individuel au cabinet" class="program-card-bg-img" />
            <div class="program-card-gradient-overlay"></div>
          </div>
          <div class="program-card-top-tag">
            <span class="program-card-tag-pill tag-coaching">01 · Coaching</span>
          </div>
          <div class="program-card-overlay-content">
            <h3 class="program-card-title-modern">Clarifier &amp; agir</h3>
            <p class="program-card-lead-modern">Dépasser une transition, retrouver une direction claire et passer à l'action.</p>
            <div class="program-card-action-row">
              <span class="program-card-action-label">Découvrir</span>
              <span class="program-card-action-btn" aria-hidden="true">↗</span>
            </div>
          </div>
        </a>

        <a href="/therapies-breves" class="program-card-modern" data-coaching-reveal>
          <div class="program-card-bg-wrapper">
            <img loading="lazy" src="/assets/step-2-explorer%20-%20nouveau%20bureau.png" alt="Thérapies brèves au cabinet" class="program-card-bg-img" />
            <div class="program-card-gradient-overlay"></div>
          </div>
          <div class="program-card-top-tag">
            <span class="program-card-tag-pill tag-therapies">02 · Thérapies brèves</span>
          </div>
          <div class="program-card-overlay-content">
            <h3 class="program-card-title-modern">Apaiser ce qui pèse</h3>
            <p class="program-card-lead-modern">Dénouer les tensions émotionnelles et retrouver de la fluidité au quotidien.</p>
            <div class="program-card-action-row">
              <span class="program-card-action-label">Découvrir</span>
              <span class="program-card-action-btn" aria-hidden="true">↗</span>
            </div>
          </div>
        </a>

        <a href="/consultation-couple" class="program-card-modern" data-coaching-reveal>
          <div class="program-card-bg-wrapper">
            <img loading="lazy" src="/assets/couple%20therapie%20-%20nouveau%20bureau.png" alt="Consultation de couple au cabinet" class="program-card-bg-img" />
            <div class="program-card-gradient-overlay"></div>
          </div>
          <div class="program-card-top-tag">
            <span class="program-card-tag-pill tag-coaching">03 · Relationnel</span>
          </div>
          <div class="program-card-overlay-content">
            <h3 class="program-card-title-modern">Cheminer ensemble</h3>
            <p class="program-card-lead-modern">Retrouver un espace de dialogue, de compréhension et de mouvement à deux.</p>
            <div class="program-card-action-row">
              <span class="program-card-action-label">Découvrir</span>
              <span class="program-card-action-btn" aria-hidden="true">↗</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
