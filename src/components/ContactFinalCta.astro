---
import { BOOKING_URL } from '../config/site';
---

<section class="section contact-final-cta">
  <div class="w-layout-blockcontainer container w-container">
    <div class="contact-final-panel" data-coaching-reveal>
      <div class="contact-final-panel__inner">
        <div class="contact-badge">
          <span class="approche-badge-dot"></span>
          Premier contact
        </div>
        
        <h2 class="contact-final-panel__title">Commençons simplement.</h2>
        
        <p class="contact-final-panel__lead">
          Cabinet à Voisins-le-Bretonneux ou en visioconférence, selon ce qui vous convient le mieux.
        </p>

        <div class="contact-final-panel__actions">
          <a href={BOOKING_URL} class="primary-button contact-btn--primary w-inline-block" data-booking-link>
            <div class="button-text-wrapper">
              <div class="button-text-inner">
                <div class="button-text">Prendre rendez-vous</div>
                <div class="button-text">Prendre rendez-vous</div>
              </div>
            </div>
          </a>
          <a href="/tarifs" class="primary-button contact-btn--secondary w-inline-block">
            <div class="button-text-wrapper">
              <div class="button-text-inner">
                <div class="button-text">Consulter les tarifs</div>
                <div class="button-text">Consulter les tarifs</div>
              </div>
            </div>
          </a>
        </div>

        <div class="contact-final-panel__meta">
          <span>2 Rue de la Bergerie, 78960 Voisins-le-Bretonneux · Yvelines · Île-de-France</span>
        </div>
      </div>
    </div>
  </div>
</section>
