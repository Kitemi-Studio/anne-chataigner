---
interface BenefitCard {
  step: string;
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  tone: 'sage' | 'blue' | 'terracotta' | 'amber';
}

interface Props {
  cards: BenefitCard[];
  sectionId?: string;
}

const { cards, sectionId = 'benefices' } = Astro.props;
---

<section class="section coaching-benefits therapies-benefits therapies-benefits-stacked" id={sectionId}>
  <div class="w-layout-blockcontainer container w-container">
    <div class="coaching-benefits__heading therapies-benefits__heading-centered" data-coaching-reveal>
      <div class="approche-badge coaching-section-badge">
        <span class="approche-badge-dot" style="background: var(--anne-therapies);"></span>
        Ce que les thérapies brèves vous apportent
      </div>
      <h2 class="heading-2">
        <span class="coaching-benefits-title-line">Des bienfaits observables dans votre </span>
        <span class="coaching-benefits-title-line">quotidien.</span>
      </h2>
      <p class="text">Pas de promesse magique : un apaisement émotionnel réel, une meilleure régulation du stress et des outils simples réutilisables toute votre vie.</p>
    </div>

    <!-- Centered Stacking Cards Container -->
    <div class="therapies-cards-stack">
      {cards.map((card, index) => (
        <article
          class={`therapies-stack-card therapies-stack-card--${card.tone}`}
          style={`--stack-index: ${index};`}
          data-coaching-reveal
        >
          <!-- Full Card Background Image -->
          <div class="therapies-stack-card__bg">
            <img src={card.image} alt={card.imageAlt} loading="lazy" width="1536" height="1024" />
            <div class="therapies-stack-card__overlay"></div>
          </div>

          <!-- Top Row Badge / Step Number -->
          <div class="therapies-stack-card__top">
            <span class="therapies-stack-card__tag">
              <span class="therapies-stack-card__tag-num">{card.step}</span>
              <span class="therapies-stack-card__tag-divider">·</span>
              <span class="therapies-stack-card__tag-eyebrow">{card.eyebrow}</span>
            </span>
          </div>

          <!-- Bottom Text Content -->
          <div class="therapies-stack-card__content">
            <h3 class="therapies-stack-card__title">{card.title}</h3>
            <p class="therapies-stack-card__desc">{card.description}</p>
            <div class="therapies-stack-card__footer">
              <span class="therapies-stack-card__pill">Clé {card.step} d'apaisement</span>
              <span class="therapies-stack-card__arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" width="20" height="20">
                  <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
