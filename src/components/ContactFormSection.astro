---
import { BOOKING_URL } from '../config/site';
---

<section class="section contact-form-section" id="formulaire">
  <div class="w-layout-blockcontainer container w-container">
    <div class="contact-layout-grid" data-coaching-reveal>
      
      <!-- Formulaire de contact accessible -->
      <div class="contact-form-card">
        <header class="contact-form-card__header">
          <div class="approche-badge contact-badge">
            <span class="approche-badge-dot"></span>
            Message direct
          </div>
          <h2 class="contact-form-card__title">Envoyer une demande</h2>
          <p class="contact-form-card__lead">
            Remplissez ce formulaire pour poser une question ou préciser votre besoin. Anne vous répondra avec attention.
          </p>
        </header>

        <form 
          class="contact-form" 
          id="ac-contact-form" 
          method="POST" 
          action="/api/contact"
          novalidate
        >
          <!-- Grid Nom & Email -->
          <div class="contact-form__row contact-form__row--2cols">
            
            <div class="contact-form__group">
              <label for="contact-name" class="contact-form__label">
                Nom &amp; prénom <span class="contact-form__required" aria-hidden="true">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                class="contact-form__input" 
                placeholder="Ex. Marie Dupont" 
                required 
                autocomplete="name"
                aria-required="true"
              />
              <span class="contact-form__error" id="error-name" aria-live="polite"></span>
            </div>

            <div class="contact-form__group">
              <label for="contact-email" class="contact-form__label">
                Adresse e-mail <span class="contact-form__required" aria-hidden="true">*</span>
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                class="contact-form__input" 
                placeholder="votre.email@exemple.fr" 
                required 
                autocomplete="email"
                aria-required="true"
              />
              <span class="contact-form__error" id="error-email" aria-live="polite"></span>
            </div>

          </div>

          <!-- Grid Téléphone & Accompagnement -->
          <div class="contact-form__row contact-form__row--2cols">
            
            <div class="contact-form__group">
              <label for="contact-phone" class="contact-form__label">
                Téléphone <span class="contact-form__optional">(facultatif)</span>
              </label>
              <input 
                type="tel" 
                id="contact-phone" 
                name="phone" 
                class="contact-form__input" 
                placeholder="06 00 00 00 00" 
                autocomplete="tel"
              />
            </div>

            <div class="contact-form__group">
              <label for="contact-service" class="contact-form__label">
                Type d'accompagnement <span class="contact-form__optional">(facultatif)</span>
              </label>
              <div class="contact-form__select-wrap">
                <select id="contact-service" name="service" class="contact-form__select">
                  <option value="">Sélectionnez une démarche...</option>
                  <option value="coaching">Coaching individuel</option>
                  <option value="therapies">Thérapies brèves</option>
                  <option value="hypnose">Hypnose Ericksonienne</option>
                  <option value="couple">Consultation de couple</option>
                  <option value="hesitation">Je ne sais pas encore</option>
                </select>
                <span class="contact-form__select-arrow" aria-hidden="true">▾</span>
              </div>
            </div>

          </div>

          <!-- Préférence de lieu -->
          <div class="contact-form__group">
            <label for="contact-preference" class="contact-form__label">
              Format souhaité <span class="contact-form__optional">(facultatif)</span>
            </label>
            <div class="contact-form__select-wrap">
              <select id="contact-preference" name="preference" class="contact-form__select">
                <option value="cabinet">Au cabinet (Voisins-le-Bretonneux)</option>
                <option value="visio">En visioconférence</option>
                <option value="indifferent">Sans préférence / À déterminer</option>
              </select>
              <span class="contact-form__select-arrow" aria-hidden="true">▾</span>
            </div>
          </div>

          <!-- Message -->
          <div class="contact-form__group">
            <label for="contact-message" class="contact-form__label">
              Votre message <span class="contact-form__required" aria-hidden="true">*</span>
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              class="contact-form__textarea" 
              rows="5" 
              placeholder="Expliquez brièvement votre démarche ou posez votre question..." 
              required 
              aria-required="true"
              aria-describedby="help-message"
            ></textarea>
            <p class="contact-form__help-text" id="help-message">
              Vous pouvez expliquer brièvement votre demande. Évitez de transmettre des informations médicales sensibles dans ce formulaire.
            </p>
            <span class="contact-form__error" id="error-message" aria-live="polite"></span>
          </div>

          <!-- Consentement -->
          <div class="contact-form__consent-group">
            <label class="contact-form__consent-label">
              <input 
                type="checkbox" 
                id="contact-consent" 
                name="consent" 
                class="contact-form__checkbox" 
                required 
                aria-required="true"
              />
              <span class="contact-form__consent-text">
                J'accepte que mes coordonnées soient utilisées uniquement pour répondre à ma demande, conformément à la <a href="/politique-confidentialite" target="_blank" rel="noopener">politique de confidentialité</a>.
              </span>
            </label>
            <span class="contact-form__error" id="error-consent" aria-live="polite"></span>
          </div>

          <!-- Status & Feedback Banner -->
          <div class="contact-form__status" id="form-status" role="status" aria-live="polite"></div>

          <!-- Bouton Submit -->
          <div class="contact-form__action">
            <button type="submit" class="primary-button contact-btn--submit" id="submit-btn">
              <span class="button-text-wrapper">
                <span class="button-text-inner">
                  <span class="button-text">Envoyer ma demande</span>
                  <span class="button-text">Envoyer ma demande</span>
                </span>
              </span>
            </button>
          </div>

        </form>
      </div>

      <!-- Sidebar : Réservation Directe -->
      <aside class="contact-sidebar">
        
        <div class="contact-booking-box">
          <div class="tarifs-badge">
            <span class="approche-badge-dot"></span>
            Agenda en ligne
          </div>

          <h3 class="contact-booking-box__title">Vous préférez réserver directement ?</h3>
          
          <p class="contact-booking-box__text">
            Consultez les disponibilités en temps réel et choisissez le format qui vous convient en quelques clics.
          </p>

          <a href={BOOKING_URL} class="primary-button contact-btn--primary contact-booking-box__btn w-inline-block" data-booking-link>
            <div class="button-text-wrapper">
              <div class="button-text-inner">
                <div class="button-text">Prendre rendez-vous</div>
                <div class="button-text">Prendre rendez-vous</div>
              </div>
            </div>
          </a>

          <ul class="contact-booking-box__list">
            <li>
              <span class="contact-booking-box__bullet">✓</span>
              <span>Facture acquittée pour mutuelle</span>
            </li>
            <li>
              <span class="contact-booking-box__bullet">✓</span>
              <span>Annulation sans frais jusqu'à 48h</span>
            </li>
            <li>
              <span class="contact-booking-box__bullet">✓</span>
              <span>Paiement sur place ou virement</span>
            </li>
          </ul>
        </div>

        <div class="contact-guarantee-card">
          <div class="contact-guarantee-card__icon" aria-hidden="true">🔒</div>
          <div>
            <strong>Confidentialité garantie</strong>
            <p>Tous les échanges sont strictement confidentiels et protégés.</p>
          </div>
        </div>

      </aside>

    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById('ac-contact-form');
    const statusEl = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');
    if (!form || !statusEl) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const nameInput = document.getElementById('contact-name');
      const emailInput = document.getElementById('contact-email');
      const messageInput = document.getElementById('contact-message');
      const consentInput = document.getElementById('contact-consent');
      const errorName = document.getElementById('error-name');
      const errorEmail = document.getElementById('error-email');
      const errorMessage = document.getElementById('error-message');
      const errorConsent = document.getElementById('error-consent');

      // Reset errors
      if (errorName) errorName.textContent = '';
      if (errorEmail) errorEmail.textContent = '';
      if (errorMessage) errorMessage.textContent = '';
      if (errorConsent) errorConsent.textContent = '';
      statusEl.className = 'contact-form__status';
      statusEl.textContent = '';

      let hasError = false;

      if (!nameInput.value.trim()) {
        if (errorName) errorName.textContent = 'Veuillez renseigner votre nom et prénom.';
        hasError = true;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
        if (errorEmail) errorEmail.textContent = 'Veuillez renseigner une adresse e-mail valide.';
        hasError = true;
      }

      if (!messageInput.value.trim()) {
        if (errorMessage) errorMessage.textContent = 'Veuillez saisir votre message.';
        hasError = true;
      }

      if (!consentInput.checked) {
        if (errorConsent) errorConsent.textContent = 'Votre consentement est requis pour le traitement de votre demande.';
        hasError = true;
      }

      if (hasError) {
        statusEl.className = 'contact-form__status contact-form__status--error';
        statusEl.textContent = 'Veuillez corriger les champs signalés avant d\'envoyer.';
        return;
      }

      // Preparation for email / endpoint transmission
      statusEl.className = 'contact-form__status contact-form__status--pending';
      statusEl.textContent = 'Préparation de votre message...';
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');

      const formData = new FormData(form);
      const service = formData.get('service') || 'Non précisé';
      const preference = formData.get('preference') || 'Non précisé';
      const phone = formData.get('phone') || 'Non renseigné';
      const subject = encodeURIComponent(`Demande de contact — ${nameInput.value.trim()}`);
      const body = encodeURIComponent(
        `Nom: ${nameInput.value.trim()}\n` +
        `E-mail: ${emailInput.value.trim()}\n` +
        `Téléphone: ${phone}\n` +
        `Accompagnement: ${service}\n` +
        `Format souhaité: ${preference}\n\n` +
        `Message:\n${messageInput.value.trim()}`
      );

      setTimeout(() => {
        statusEl.className = 'contact-form__status contact-form__status--success';
        statusEl.innerHTML = 'Votre logiciel de messagerie va s\'ouvrir pour finaliser l\'envoi de votre demande.<br><small>Si rien ne se passe, vous pouvez utiliser directement la prise de rendez-vous en ligne.</small>';
        window.location.href = `mailto:contact@anne-chataigner.fr?subject=${subject}&body=${body}`;
        if (submitBtn) submitBtn.removeAttribute('disabled');
      }, 500);
    });
  })();
</script>
