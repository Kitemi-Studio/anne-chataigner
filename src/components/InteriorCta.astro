---
import { BOOKING_URL } from '../config/site';

interface Props {
  title?: string;
  lead?: string;
  buttonText?: string;
}

const {
  title = 'Vous traversez une étape importante ?',
  lead = 'Un premier échange peut vous permettre de poser ce qui se joue, de clarifier vos besoins et de voir si cet accompagnement vous correspond.',
  buttonText = 'Prendre rendez-vous'
} = Astro.props;
---

<section class="ac-cta" id="contact">
  <div class="ac-cta__media" aria-hidden="true">
    <img src="/assets/anne%20hero%20header%202.png" alt="" width="1536" height="1024" loading="lazy" />
    <div class="ac-cta__veil"></div>
  </div>
  <div class="ac-container ac-cta__inner">
    <div class="ac-cta__copy">
      <p class="ac-eyebrow ac-eyebrow--light"><span></span>Premier échange</p>
      <h2>{title}</h2>
      <p>{lead}</p>
      <a href={BOOKING_URL} class="ac-button ac-button--light" data-booking-link>
        <span>{buttonText}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="ac-cta__aside">
      <div class="ac-cta__rule"></div>
      <p>Cabinet à Voisins-le-Bretonneux<br />et séances en visioconférence</p>
      <span class="ac-location-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none">
          <path d="M16.5 8.2c0 4.1-6.5 8.8-6.5 8.8S3.5 12.3 3.5 8.2a6.5 6.5 0 1 1 13 0Z" stroke="currentColor" stroke-width="1.3" />
          <circle cx="10" cy="8" r="2.1" stroke="currentColor" stroke-width="1.3" />
        </svg>
      </span>
    </div>
  </div>
</section>
