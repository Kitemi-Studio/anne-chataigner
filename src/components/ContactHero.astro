---
import { BOOKING_URL } from '../config/site';
---

<section class="section contact-hero" id="accueil">
  <div class="w-layout-blockcontainer container w-container">
    <div class="contact-hero__grid">
      
      <!-- Colonne Gauche : Titre & Actions -->
      <div class="contact-hero__copy" data-coaching-reveal>
        <div class="approche-badge contact-badge">
          <span class="approche-badge-dot"></span>
          Premier échange
        </div>
        
        <h1 class="contact-hero__title">Contactez Anne Chataigner</h1>
        
        <p class="contact-hero__lead">
          Une première rencontre permet de faire le point sur votre situation et de voir si l’accompagnement proposé vous correspond.
        </p>

        <div class="contact-hero__actions">
          <a href={BOOKING_URL} class="primary-button contact-btn--primary w-inline-block" data-booking-link>
            <div class="button-text-wrapper">
              <div class="button-text-inner">
                <div class="button-text">Prendre rendez-vous</div>
                <div class="button-text">Prendre rendez-vous</div>
              </div>
            </div>
          </a>
          <a href="#formulaire" class="contact-hero__link-secondary">
            <span>Écrire un message</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Colonne Droite : Repères Clés -->
      <div class="contact-hero__summary-card" data-coaching-reveal>
        <div class="contact-hero__card-header">
          <span class="contact-hero__card-tag">Cadre &amp; Accueil</span>
          <span class="contact-hero__card-location">Voisins-le-Bretonneux</span>
        </div>

        <ul class="contact-hero__card-list">
          <li class="contact-hero__card-item">
            <span class="contact-hero__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </span>
            <div>
              <strong>Cabinet à Voisins-le-Bretonneux</strong>
              <span>2 Rue de la Bergerie, 78960 · Espace calme et confidentiel</span>
            </div>
          </li>
          <li class="contact-hero__card-item">
            <span class="contact-hero__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
            </span>
            <div>
              <strong>Consultations en visioconférence</strong>
              <span>Pour les personnes éloignées ou en déplacement</span>
            </div>
          </li>
          <li class="contact-hero__card-item">
            <span class="contact-hero__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>
            <div>
              <strong>4 accompagnements proposés</strong>
              <span>Coaching, thérapies brèves, hypnose et couple</span>
            </div>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
