---
interface ProcessStep {
  number: string;
  title: string;
  description: string;
  keypoints?: string[];
}

interface PricingBannerData {
  tag?: string;
  title: string;
  description: string;
  amount: string;
  duration: string;
  linkText?: string;
  linkUrl?: string;
}

interface Props {
  subtitle?: string;
  title?: string;
  lead?: string;
  steps: ProcessStep[];
  pricingBanner?: PricingBannerData;
  sectionId?: string;
  bgColor?: string;
}

const {
  subtitle = 'Méthode & déroulement',
  title = "Comment se déroule l'accompagnement ?",
  lead = "Un cadre clair et confidentiel qui avance à votre rythme.",
  steps,
  pricingBanner,
  sectionId = 'deroulement'
} = Astro.props;
---

<section class="ac-section ac-process" id={sectionId}>
  <div class="ac-container">
    <div class="ac-section-heading ac-section-heading--split">
      <div>
        <p class="ac-eyebrow"><span></span>{subtitle}</p>
        <h2>{title}</h2>
      </div>
      <p class="ac-section-heading__lead">{lead}</p>
    </div>

    <ol class="ac-timeline">
      {steps.map((step, index) => (
        <li class="ac-timeline__item">
          <div class="ac-timeline__marker">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="ac-timeline__content">
            <p class="ac-timeline__label">{step.number}</p>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            {step.keypoints && step.keypoints.length > 0 && (
              <ul class="ac-timeline__points">
                {step.keypoints.map((point) => (
                  <li>
                    <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                      <path d="m5 10.5 3.2 3.2L15 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    {pricingBanner && (
      <div class="ac-price-callout">
        <div class="ac-price-callout__copy">
          <p class="ac-eyebrow"><span></span>{pricingBanner.tag || 'Modalités & tarif'}</p>
          <h3>{pricingBanner.title}</h3>
          <p>{pricingBanner.description}</p>
        </div>
        <div class="ac-price-callout__price">
          <strong>{pricingBanner.amount}</strong>
          <span>{pricingBanner.duration}</span>
          <a href={pricingBanner.linkUrl || '/tarifs'} class="ac-text-link">{pricingBanner.linkText || 'Voir les tarifs'} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    )}
  </div>
</section>
