---
import { BOOKING_URL } from '../config/site';
---

<section class="section hero-anne-full therapies-hero" id="accueil">
  <div class="w-layout-blockcontainer container w-container">
    <div class="hero-full-content">
      <div class="hero-badge-pill hero-badge-pill--therapies">
        <span class="hero-badge-dot"></span>
        Thérapies brèves intégratives · Équilibre &amp; apaisement
      </div>
      <h1 hero-text="" class="hero-full-title">Apaiser ce qui pèse et retrouver votre équilibre émotionnel.</h1>
      <p class="hero-full-lead">
        Un accompagnement concret, personnalisé et à votre rythme. Parce qu'il n'est pas nécessaire d'aller mal pour se faire accompagner, les thérapies brèves vous aident à dénouer les tensions, comprendre vos mécanismes et retrouver de la fluidité au quotidien.
      </p>
      <div class="hero-full-buttons">
        <a href={BOOKING_URL} class="primary-button button-hero-primary--rose w-inline-block" data-booking-link>
          <div class="button-text-wrapper">
            <div class="button-text-inner">
              <div button-text="" class="button-text">Prendre rendez-vous</div>
              <div button-text="" class="button-text">Prendre rendez-vous</div>
            </div>
          </div>
        </a>
        <a href="#deroulement" class="primary-button button-hero-secondary button-hero-secondary--rose w-inline-block">
          <div class="button-text-wrapper">
            <div class="button-text-inner">
              <div button-text="" class="button-text">Découvrir la méthode</div>
              <div button-text="" class="button-text">Découvrir la méthode</div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<div class="hero-scroll-wrapper therapies-hero-scroll">
  <a href="#reperes" class="hero-scroll-indicator dark-mode" aria-label="Faire défiler vers votre point de départ">
    <span class="apple-mouse-icon">
      <span class="apple-mouse-wheel"></span>
    </span>
    <span class="hero-scroll-label">Découvrir</span>
  </a>
</div>
