---
interface Props {
  sectionId?: string;
}

const { sectionId = 'approche-eclairage' } = Astro.props;

const keypoints = [
  {
    number: "01",
    eyebrow: "Régulation somatique",
    title: "Désactivation du stress aigu",
    description: "Apaiser les réactions physiques d'alerte et relâcher les tensions musculaires pour réinstaller une sensation immédiate de sécurité."
  },
  {
    number: "02",
    eyebrow: "Prise de recul",
    title: "Recadrage des croyances",
    description: "Prendre de la distance avec les pensées automatiques, les peurs anticipatoires et les ruminations qui alimentent la charge mentale."
  },
  {
    number: "03",
    eyebrow: "Pérennité",
    title: "Autonomie émotionnelle durable",
    description: "Acquérir des repères concrets et des micro-rituels simples pour réguler vos émotions de manière autonome et sereine au quotidien."
  }
];
---

<section class="section therapies-approach" id={sectionId}>
  <div class="w-layout-blockcontainer container w-container">
    <header class="therapies-approach__header" data-coaching-reveal>
      <div class="approche-badge coaching-section-badge">
        <span class="approche-badge-dot" style="background: var(--anne-therapies);"></span>
        Compréhension &amp; approche
      </div>
      <h2 class="heading-2">
        <span class="therapies-approach-title-line">Le « comment faire autrement » :</span>
        <span class="therapies-approach-title-line">Agir sur la mécanique du présent.</span>
      </h2>
      <p>Pourquoi ressasser le passé ne suffit-il souvent pas à aller mieux ? Parce que la compréhension intellectuelle d'une difficulté n'apaise pas automatiquement l'émotion. En thérapies brèves, nous intervenons directement là où le problème se manifeste aujourd'hui.</p>
    </header>

    <!-- Diagramme Circulaire Aéré & Interactif (Sans grosse card extérieure) -->
    <div class="therapies-diagram-viewport" data-coaching-reveal>
      <div class="therapies-diagram-wrap" id="therapiesDiagramWrap">
        <!-- SVG Orbit Rings & Rotating Connection Rays -->
        <svg class="therapies-diagram-svg" viewBox="0 0 600 600" fill="none" aria-hidden="true">
          <!-- Outer Pulsing Halo -->
          <circle cx="300" cy="300" r="220" stroke="rgba(126, 145, 122, 0.18)" stroke-width="1" />
          
          <!-- Dashed Orbit Ring with Dynamic Rotation -->
          <g class="therapies-diagram-orbit-group" id="therapiesOrbitGroup">
            <circle cx="300" cy="300" r="180" stroke="rgba(126, 145, 122, 0.4)" stroke-width="1.6" stroke-dasharray="5 5" />
            <!-- Connection Lines to Nodes -->
            <line x1="300" y1="300" x2="300" y2="120" stroke="rgba(126, 145, 122, 0.5)" stroke-width="1.5" class="diagram-line diagram-line--top" />
            <line x1="300" y1="300" x2="144" y2="390" stroke="rgba(126, 145, 122, 0.5)" stroke-width="1.5" class="diagram-line diagram-line--left" />
            <line x1="300" y1="300" x2="456" y2="390" stroke="rgba(126, 145, 122, 0.5)" stroke-width="1.5" class="diagram-line diagram-line--right" />
            
            <!-- Orbiting Decorative Satellites -->
            <circle cx="300" cy="120" r="4" fill="#7E917A" />
            <circle cx="144" cy="390" r="4" fill="#7E917A" />
            <circle cx="456" cy="390" r="4" fill="#7E917A" />
          </g>
        </svg>

        <!-- Centre Interactif : Le Présent & Point de changement -->
        <div class="therapies-diagram-center" id="diagramCenter" tabindex="0">
          <div class="therapies-diagram-center__pulse"></div>
          <span class="therapies-diagram-center__tag">Ici &amp; maintenant</span>
          <h3 class="therapies-diagram-center__title">Le Présent</h3>
          <p class="therapies-diagram-center__desc">Boucle émotionnelle &amp; point de bascule</p>
        </div>

        <!-- Pôle 1 : Le Corps (Haut) -->
        <div class="therapies-diagram-node therapies-diagram-node--top" data-node="corps" tabindex="0">
          <div class="therapies-diagram-node__dot">
            <span class="therapies-diagram-node__dot-inner"></span>
          </div>
          <div class="therapies-diagram-node__card">
            <div class="therapies-diagram-node__badge">Dimension 01</div>
            <h4>Le Corps</h4>
            <p>Système nerveux, sensations physiques &amp; réactions d'alerte</p>
          </div>
        </div>

        <!-- Pôle 2 : Les Pensées (Bas Gauche) -->
        <div class="therapies-diagram-node therapies-diagram-node--left" data-node="pensees" tabindex="0">
          <div class="therapies-diagram-node__dot">
            <span class="therapies-diagram-node__dot-inner"></span>
          </div>
          <div class="therapies-diagram-node__card">
            <div class="therapies-diagram-node__badge">Dimension 02</div>
            <h4>Les Pensées</h4>
            <p>Ruminations, croyances automatiques &amp; filtres mentaux</p>
          </div>
        </div>

        <!-- Pôle 3 : Les Relations (Bas Droite) -->
        <div class="therapies-diagram-node therapies-diagram-node--right" data-node="relations" tabindex="0">
          <div class="therapies-diagram-node__dot">
            <span class="therapies-diagram-node__dot-inner"></span>
          </div>
          <div class="therapies-diagram-node__card">
            <div class="therapies-diagram-node__badge">Dimension 03</div>
            <h4>Les Relations</h4>
            <p>Interactions, schémas répétitifs &amp; place avec l'autre</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 Cartes de Points Clés Modernisées & Élégantes -->
    <div class="therapies-keypoints-modern-grid" data-coaching-reveal>
      {keypoints.map((kp) => (
        <article class="therapies-modern-card">
          <div class="therapies-modern-card__top">
            <span class="therapies-modern-card__tag">
              <span class="therapies-modern-card__dot"></span>
              {kp.number} · {kp.eyebrow}
            </span>
            <div class="therapies-modern-card__icon-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>

          <h3 class="therapies-modern-card__title">{kp.title}</h3>
          <p class="therapies-modern-card__desc">{kp.description}</p>

          <div class="therapies-modern-card__bottom">
            <span class="therapies-modern-card__indicator"></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  (() => {
    const wrap = document.getElementById('therapiesDiagramWrap');
    const orbit = document.getElementById('therapiesOrbitGroup');
    const center = document.getElementById('diagramCenter');
    const nodes = document.querySelectorAll('.therapies-diagram-node');

    if (!wrap || !orbit) return;

    let currentRotation = 0;
    let targetRotation = 0;
    let isHovering = false;

    // Smooth subtle rotation on scroll
    const onScroll = () => {
      const rect = wrap.getBoundingClientRect();
      const windowH = window.innerHeight;
      if (rect.bottom > 0 && rect.top < windowH) {
        const progress = (windowH - rect.top) / (windowH + rect.height);
        targetRotation = (progress - 0.5) * 40; // -20deg to +20deg
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const animate = () => {
      if (!isHovering) {
        currentRotation += (targetRotation - currentRotation) * 0.08;
        orbit.style.transform = `rotate(${currentRotation}deg)`;
        orbit.style.transformOrigin = '300px 300px';
      }
      requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);

    // Interactive Hover highlighting
    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => {
        isHovering = true;
        node.classList.add('is-active');
        wrap.classList.add('has-node-hover');
      });
      node.addEventListener('mouseleave', () => {
        isHovering = false;
        node.classList.remove('is-active');
        wrap.classList.remove('has-node-hover');
      });
    });

    if (center) {
      center.addEventListener('mouseenter', () => {
        wrap.classList.add('has-center-hover');
      });
      center.addEventListener('mouseleave', () => {
        wrap.classList.remove('has-center-hover');
      });
    }
  })();
</script>
