---
---

<section class="section about-compass-section" id="boussole">
  <div class="w-layout-blockcontainer container w-container">
    <div class="about-compass__inner">
      
      <header class="about-compass__header" data-coaching-reveal>
        <div class="approche-badge about-badge">
          <span class="approche-badge-dot"></span>
          Repères &amp; Posture
        </div>
        <h2 class="about-compass__title">Ce qui guide chaque séance.</h2>
        <p class="about-compass__lead">
          Les outils ne sont jamais appliqués de manière rigide. Ils s'articulent autour de quatre directions cardinales pour répondre exactement à ce que vous traversez.
        </p>
      </header>

      <!-- Visualisation Boussole Éditoriale Graphique -->
      <div class="about-compass-viewport" data-coaching-reveal>
        
        <!-- SVG Hairlines & Cardinal Cross -->
        <svg class="about-compass-svg" viewBox="0 0 800 600" fill="none" aria-hidden="true">
          <!-- Horizontal Axis Line -->
          <line x1="80" y1="300" x2="720" y2="300" stroke="rgba(126, 145, 122, 0.28)" stroke-width="1.5" stroke-dasharray="4 4" />
          <!-- Vertical Axis Line -->
          <line x1="400" y1="60" x2="400" y2="540" stroke="rgba(126, 145, 122, 0.28)" stroke-width="1.5" stroke-dasharray="4 4" />
          <!-- Cardinal Circle Guides -->
          <circle cx="400" cy="300" r="180" stroke="rgba(126, 145, 122, 0.16)" stroke-width="1" />
          <circle cx="400" cy="300" r="80" stroke="rgba(126, 145, 122, 0.22)" stroke-width="1" />
        </svg>

        <!-- Centre : L'Accompagnement Juste -->
        <div class="about-compass__center">
          <span class="about-compass__center-dot"></span>
          <span class="about-compass__center-text">L'accompagnement juste</span>
        </div>

        <!-- Direction Nord (Haut) : Le Pas de Côté -->
        <div class="about-compass-node about-compass-node--north" tabindex="0">
          <div class="about-compass-node__tag">Direction Nord · Angle de vue</div>
          <h3 class="about-compass-node__title">Le pas de côté</h3>
          <p class="about-compass-node__desc">
            S'extraire du tourbillon quotidien pour observer une situation sous un angle neuf et faire émerger des solutions insoupçonnées.
          </p>
        </div>

        <!-- Direction Est (Droite) : La Spirale des Petits Pas -->
        <div class="about-compass-node about-compass-node--east" tabindex="0">
          <div class="about-compass-node__tag">Direction Est · Mouvement</div>
          <h3 class="about-compass-node__title">La spirale des petits pas</h3>
          <p class="about-compass-node__desc">
            Des micro-actions réalistes et répétées avec confiance, qui créent une dynamique d'apaisement et de transformation pérenne.
          </p>
        </div>

        <!-- Direction Sud (Bas) : Vos Ressources Intérieures -->
        <div class="about-compass-node about-compass-node--south" tabindex="0">
          <div class="about-compass-node__tag">Direction Sud · Ancrage</div>
          <h3 class="about-compass-node__title">Vos ressources intérieures</h3>
          <p class="about-compass-node__desc">
            Vous êtes l'expert(e) de votre propre vie. Mon rôle consiste à réactiver les forces, mémoires positives et leviers que vous portez déjà.
          </p>
        </div>

        <!-- Direction Ouest (Gauche) : Une Boîte à Outils Intégrative -->
        <div class="about-compass-node about-compass-node--west" tabindex="0">
          <div class="about-compass-node__tag">Direction Ouest · Méthode</div>
          <h3 class="about-compass-node__title">Une boîte à outils intégrative</h3>
          <p class="about-compass-node__desc">
            Coaching, hypnose et thérapies brèves mobilisés avec discernement, sans dogme, selon votre sensibilité et votre rythme.
          </p>
        </div>

      </div>

    </div>
  </div>
</section>
