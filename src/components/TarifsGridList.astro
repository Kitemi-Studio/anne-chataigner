---
---

<section class="section tarifs-grid-section" id="grille">
  <div class="w-layout-blockcontainer container w-container">
    <div class="tarifs-grid__inner">
      
      <header class="tarifs-grid__header" data-coaching-reveal>
        <div class="approche-badge tarifs-badge">
          <span class="approche-badge-dot"></span>
          Grille des formules
        </div>
        <h2 class="tarifs-grid__title">Trois formats, un cadre financier lisible.</h2>
        <p class="tarifs-grid__lead">
          Des temps de consultation généreux et structurés pour vous permettre d'avancer en profondeur et en toute sérénité.
        </p>
      </header>

      <!-- Liste Tarifaire Interactive avec couleurs spécifiques -->
      <div class="tarifs-rows-list" data-coaching-reveal>
        
        <!-- Ligne 01 : Consultation individuelle (Bleu Coaching) -->
        <a href="/coaching" class="tarifs-row tarifs-row--coaching" aria-label="Consulter l'offre Coaching & Thérapies brèves">
          <div class="tarifs-row__num">01</div>
          <div class="tarifs-row__main">
            <div class="tarifs-row__tag">Coaching &amp; Thérapies brèves</div>
            <h3 class="tarifs-row__title">Consultation individuelle</h3>
            <p class="tarifs-row__desc">
              Un temps d'échange personnalisé pour clarifier votre situation, poser vos priorités et retrouver votre élan au quotidien.
            </p>
          </div>
          <div class="tarifs-row__pricing">
            <span class="tarifs-row__price">85 €</span>
            <span class="tarifs-row__duration">1 heure</span>
          </div>
          <div class="tarifs-row__action">
            <span class="tarifs-row__action-label">Découvrir l'approche</span>
            <span class="tarifs-row__action-arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <!-- Ligne 02 : Séance d'hypnose (Jaune Doré Hypnose) -->
        <a href="/hypnose-ericksonienne" class="tarifs-row tarifs-row--hypnose" aria-label="Consulter l'offre Hypnose Ericksonienne">
          <div class="tarifs-row__num">02</div>
          <div class="tarifs-row__main">
            <div class="tarifs-row__tag">Hypnose Ericksonienne</div>
            <h3 class="tarifs-row__title">Séance d'hypnose</h3>
            <p class="tarifs-row__desc">
              Questionnaire préparatoire, échange de précision, séance personnalisée et temps de retour en fin de rendez-vous.
            </p>
          </div>
          <div class="tarifs-row__pricing">
            <span class="tarifs-row__price">110 €</span>
            <span class="tarifs-row__duration">1 h 15</span>
          </div>
          <div class="tarifs-row__action">
            <span class="tarifs-row__action-label">Découvrir l'approche</span>
            <span class="tarifs-row__action-arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <!-- Ligne 03 : Consultation de couple (Rose Saumon / Espace relationnel) -->
        <a href="/consultation-couple" class="tarifs-row tarifs-row--couple" aria-label="Consulter l'offre Consultation de couple">
          <div class="tarifs-row__num">03</div>
          <div class="tarifs-row__main">
            <div class="tarifs-row__tag">Espace relationnel</div>
            <h3 class="tarifs-row__title">Consultation de couple</h3>
            <p class="tarifs-row__desc">
              Un espace neutre, confidentiel et sécurisant pour permettre à chacun de s'exprimer, restaurer le dialogue et cheminer ensemble.
            </p>
          </div>
          <div class="tarifs-row__pricing">
            <span class="tarifs-row__price">150 €</span>
            <span class="tarifs-row__duration">1 h 30</span>
          </div>
          <div class="tarifs-row__action">
            <span class="tarifs-row__action-label">Découvrir l'approche</span>
            <span class="tarifs-row__action-arrow" aria-hidden="true">↗</span>
          </div>
        </a>

      </div>

    </div>
  </div>
</section>
