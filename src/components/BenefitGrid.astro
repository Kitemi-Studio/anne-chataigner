---
interface BenefitCard {
  step: string;
  title: string;
  description: string;
  color?: string;
  iconType?: string;
}

interface Props {
  subtitle?: string;
  title?: string;
  lead?: string;
  cards: BenefitCard[];
  sectionId?: string;
}

const {
  subtitle = 'Bénéfices & repères',
  title = 'Ce que cet accompagnement peut ouvrir',
  lead = 'Des repères concrets à observer dans votre quotidien, sans promesse magique.',
  cards,
  sectionId = 'benefices'
} = Astro.props;

const icons: Record<string, string> = {
  compass: '<circle cx="10" cy="10" r="7"></circle><path d="m13 7-2 5-5 2 2-5 5-2Z"></path><path d="M16 16 20 20"></path>',
  shield: '<path d="M10 20s7-3.5 7-9V5l-7-3-7 3v6c0 5.5 7 9 7 9Z"></path><path d="m7.5 10 1.7 1.7 3.5-3.5"></path>',
  heart: '<path d="M17.5 11.5c1.4-1.3 2.5-2.7 2.5-4.5A4 4 0 0 0 16 3c-2 0-3 1.2-4 2.5C11 4.2 10 3 8 3a4 4 0 0 0-4 4c0 1.8 1.1 3.2 2.5 4.5L12 16l5.5-4.5Z"></path><path d="M12 16v4"></path>',
  zap: '<path d="m12 2-7 11h6l-1 9 7-11h-6l1-9Z"></path>',
  eye: '<path d="M2 10s3.5-5 8-5 8 5 8 5-3.5 5-8 5-8-5-8-5Z"></path><circle cx="10" cy="10" r="2"></circle>',
  feather: '<path d="M18 3c-5 0-8.5 2.5-10 7.5C7 14 4 17 2 18"></path><path d="M18 3c0 6-3 10-9 12"></path><path d="M4 16h6"></path>',
  sparkles: '<path d="M10 2v4M10 14v4M4 10h4M12 10h4M5.7 5.7l2.8 2.8M11.5 11.5l2.8 2.8M14.3 5.7l-2.8 2.8M8.5 11.5l-2.8 2.8"></path>',
  users: '<circle cx="8" cy="7" r="3"></circle><path d="M2 18c0-3 2.5-5 6-5s6 2 6 5"></path><path d="M15 5.5a3 3 0 0 1 0 5.8M16 13c2.5.5 4 2 4 4"></path>',
  layers: '<path d="m10 2 8 4-8 4-8-4 8-4Z"></path><path d="m2 10 8 4 8-4M2 14l8 4 8-4"></path>'
};
---

<section class="ac-section ac-benefits" id={sectionId}>
  <div class="ac-container">
    <div class="ac-section-heading ac-section-heading--split">
      <div>
        <p class="ac-eyebrow"><span></span>{subtitle}</p>
        <h2>{title}</h2>
      </div>
      <p class="ac-section-heading__lead">{lead}</p>
    </div>

    <div class="ac-benefits__grid">
      {cards.map((card, index) => (
        <article class={`ac-benefit ac-benefit--${index + 1}`}>
          <div class="ac-benefit__topline">
            <span class="ac-benefit__number">{card.step}</span>
            <span class="ac-benefit__icon" data-color={card.color || 'blue'}>
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" set:html={icons[card.iconType || 'compass'] || icons.compass}></svg>
            </span>
          </div>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
