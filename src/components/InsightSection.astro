---
interface KeypointItem {
  title: string;
  description: string;
}

interface Props {
  badgeText?: string;
  badgeType?: string;
  title: string;
  lead: string;
  bodyParagraphs: string[];
  highlightBoxTitle?: string;
  highlightBoxText?: string;
  keypoints?: KeypointItem[];
  sectionId?: string;
  bgColor?: string;
}

const {
  badgeText = 'Éclairage & compréhension',
  badgeType = 'coaching',
  title,
  lead,
  bodyParagraphs,
  highlightBoxTitle,
  highlightBoxText,
  keypoints = [],
  sectionId = 'approche-eclairage'
} = Astro.props;
---

<section class={`ac-section ac-approach ac-theme--${badgeType}`} id={sectionId}>
  <div class="ac-container">
    <div class="ac-approach__grid">
      <div class="ac-approach__copy">
        <p class="ac-eyebrow"><span></span>{badgeText}</p>
        <h2>{title}</h2>
        <p class="ac-lead">{lead}</p>
        <div class="ac-prose">
          {bodyParagraphs.map((paragraph) => <p set:html={paragraph}></p>)}
        </div>
      </div>

      <div class="ac-approach__visual">
        <div class="ac-approach__loop" aria-label="Repères de l'approche">
          <div class="ac-loop__arc" aria-hidden="true"></div>
          <div class="ac-loop__center">
            <span>Faire<br />un pas<br />de côté</span>
          </div>
          {keypoints.slice(0, 3).map((point, index) => (
            <div class={`ac-loop__point ac-loop__point--${index + 1}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{point.title}</strong>
            </div>
          ))}
        </div>

        {highlightBoxTitle && (
          <div class="ac-approach__note">
            <p class="ac-eyebrow"><span></span>Point de repère</p>
            <h3>{highlightBoxTitle}</h3>
            {highlightBoxText && <p set:html={highlightBoxText}></p>}
          </div>
        )}
      </div>
    </div>

    {keypoints.length > 0 && (
      <div class="ac-keypoints">
        {keypoints.map((point, index) => (
          <div class="ac-keypoint">
            <span class="ac-keypoint__number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
