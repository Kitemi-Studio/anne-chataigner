---
import { BOOKING_URL } from '../config/site';

interface SituationTag {
  text: string;
  color?: string;
}

interface Props {
  tags: SituationTag[];
  sectionId?: string;
}

const { tags, sectionId = 'reperes' } = Astro.props;
const visibleTags = tags.slice(0, 14);
---

<section class="section coaching-situations hypnose-situations" id={sectionId}>
  <div class="w-layout-blockcontainer container w-container">
    <div class="coaching-situations__grid">
      <div class="coaching-situations__media" data-coaching-reveal>
        <img src="/assets/nouvelles%20images/hypnose-point-depart-nouveau-client-3x2.webp" alt="Séance d'hypnose ericksonienne au cabinet d’Anne Chataigner" loading="lazy" width="1535" height="1024" />
        <div class="coaching-situations__media-wash"></div>
        <div class="coaching-situations__caption">
          <span class="coaching-situations__caption-dot" style="background: var(--anne-hypnose-gold);"></span>
          <span>Un premier point de départ</span>
        </div>
        <div class="coaching-situations__quote-bubble">
          <p class="coaching-situations__quote">« Votre inconscient en sait beaucoup plus que vous ne croyez en savoir. » <span class="hypnose-quote-author">— Milton H. Erickson</span></p>
        </div>
      </div>

      <div class="coaching-situations__copy" data-coaching-reveal>
        <div class="approche-badge coaching-section-badge">
          <span class="approche-badge-dot"></span>
          Votre point de départ
        </div>
        <h2 class="heading-2">Des demandes couramment accompagnées en hypnose.</h2>
        <p class="coaching-situations__lead">L'hypnose permet d'agir avec finesse là où la seule volonté intellectuelle se heurte à des automatismes anciens ou des blocages émotionnels profonds.</p>

        <div class="pas-de-cote-grid coaching-situations__checklist" aria-label="Demandes accompagnées en hypnose">
          {visibleTags.map((tag) => (
            <div class="pas-de-cote-item coaching-situation-check--gold">
              <div class="pas-de-cote-item-icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{tag.text}</span>
            </div>
          ))}
        </div>

        <div class="pas-de-cote-cta coaching-situations__cta">
          <a href={BOOKING_URL} data-wf--button--variant="primary" class="primary-button w-inline-block" data-booking-link>
            <div class="button-text-wrapper">
              <div class="button-text-inner">
                <div button-text="" class="button-text">Prendre rendez-vous</div>
                <div button-text="" class="button-text">Prendre rendez-vous</div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
