---
---

<section class="section about-approaches-index" id="approches">
  <div class="w-layout-blockcontainer container w-container">
    <div class="about-approaches-index__inner">
      
      <header class="about-approaches-index__header" data-coaching-reveal>
        <div class="approche-badge about-badge">
          <span class="approche-badge-dot"></span>
          Approches &amp; Pratiques
        </div>
        <h2 class="about-approaches-index__title">Trois portes d'entrée. Un même fil conducteur.</h2>
        <p class="about-approaches-index__lead">
          Le fil conducteur reste invariable : vous aider à clarifier, apaiser et avancer à votre propre rythme, que vous veniez pour un défi précis ou une quête d'équilibre global.
        </p>
      </header>

      <!-- Index Éditorial Vertical Numéroté -->
      <div class="about-index-list" data-coaching-reveal>
        
        <!-- Ligne 01 : Coaching -->
        <a href="/coaching" class="about-index-row about-index-row--coaching">
          <div class="about-index-row__num">01</div>
          <div class="about-index-row__main">
            <div class="about-index-row__tag">
              <span class="about-index-row__dot" style="background: #8192AC;"></span>
              Coaching individuel &amp; de transition
            </div>
            <h3 class="about-index-row__heading">Clarifier votre cap &amp; passer à l'action</h3>
            <p class="about-index-row__text">
              Idéal pour dépasser une transition professionnelle ou personnelle, trier les priorités, poser des limites saines et retrouver une direction nette.
            </p>
          </div>
          <div class="about-index-row__action">
            <span class="about-index-row__action-btn" aria-hidden="true">↗</span>
          </div>
        </a>

        <!-- Ligne 02 : Thérapies Brèves -->
        <a href="/therapies-breves" class="about-index-row about-index-row--therapies">
          <div class="about-index-row__num">02</div>
          <div class="about-index-row__main">
            <div class="about-index-row__tag">
              <span class="about-index-row__dot" style="background: #DFA38B;"></span>
              Thérapies brèves intégratives
            </div>
            <h3 class="about-index-row__heading">Apaiser ce qui pèse &amp; réguler l'émotionnel</h3>
            <p class="about-index-row__text">
              Pour dénouer les tensions, calmer le système nerveux, désactiver les schémas répétitifs et traverser les épreuves de vie avec douceur et pragmatisme.
            </p>
          </div>
          <div class="about-index-row__action">
            <span class="about-index-row__action-btn" aria-hidden="true">↗</span>
          </div>
        </a>

        <!-- Ligne 03 : Hypnose Ericksonienne -->
        <a href="/hypnose-ericksonienne" class="about-index-row about-index-row--hypnose">
          <div class="about-index-row__num">03</div>
          <div class="about-index-row__main">
            <div class="about-index-row__tag">
              <span class="about-index-row__dot" style="background: #D6A24F;"></span>
              Hypnose Ericksonienne
            </div>
            <h3 class="about-index-row__heading">Mobiliser vos ressources profondes &amp; inconscientes</h3>
            <p class="about-index-row__text">
              Une démarche collaborative et feutrée pour dialoguer avec votre inconscient, lever les blocages anciens et reprogrammer les automatismes limitants.
            </p>
          </div>
          <div class="about-index-row__action">
            <span class="about-index-row__action-btn" aria-hidden="true">↗</span>
          </div>
        </a>

      </div>

    </div>
  </div>
</section>
