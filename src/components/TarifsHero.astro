---
import { BOOKING_URL } from '../config/site';
---

<section class="section tarifs-hero" id="accueil">
  <div class="w-layout-blockcontainer container w-container">
    <div class="tarifs-hero__grid">
      
      <!-- Colonne Gauche : Titre & Introduction -->
      <div class="tarifs-hero__copy" data-coaching-reveal>
        <div class="approche-badge tarifs-badge">
          <span class="approche-badge-dot"></span>
          Transparence &amp; Modalités
        </div>
        
        <h1 class="tarifs-hero__title">Tarifs des consultations &amp; séances</h1>
        
        <p class="tarifs-hero__lead">
          Une politique tarifaire claire, fixe et sans surprise. Choisissez le format qui correspond à votre situation ou convenons-en ensemble lors de votre premier échange.
        </p>

        <div class="tarifs-hero__actions">
          <a href={BOOKING_URL} class="primary-button tarifs-btn--primary w-inline-block" data-booking-link>
            <div class="button-text-wrapper">
              <div class="button-text-inner">
                <div class="button-text">Prendre rendez-vous</div>
                <div class="button-text">Prendre rendez-vous</div>
              </div>
            </div>
          </a>
          <a href="#grille" class="tarifs-hero__link-secondary">
            <span>Consulter la grille</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Colonne Droite : Image Immersion Cadre & Cabinet -->
      <div class="tarifs-hero__media-wrap" data-coaching-reveal>
        <div class="tarifs-hero__frame">
          <img 
            src="/assets/step-4-avancer%20-%20Anne.webp" 
            alt="Anne Chataigner, cadre de consultation et d'écoute à Voisins-le-Bretonneux" 
            class="tarifs-hero__img" 
            width="1536" 
            height="1024" 
            loading="eager"
          />
          <div class="tarifs-hero__badge-floating" aria-hidden="true">
            <span class="tarifs-hero__badge-price">À partir de 85 €</span>
            <span class="tarifs-hero__badge-sub">Cabinet &amp; visio</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
