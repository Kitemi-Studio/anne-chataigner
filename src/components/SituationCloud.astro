---
interface TagItem {
  text: string;
  color?: string;
  size?: 'sm' | 'md' | 'lg';
}

interface Props {
  subtitle?: string;
  title?: string;
  lead?: string;
  tags: TagItem[];
  quote?: string;
  sectionId?: string;
  theme?: string;
}

const {
  subtitle = 'Votre point de départ',
  title = 'Des situations concrètes dans lesquelles vous pouvez vous reconnaître',
  lead = "Il n'est pas nécessaire de cocher toutes les cases : un seul de ces signaux peut être le point de départ d'une réflexion.",
  tags,
  quote,
  sectionId = 'reperes',
  theme = 'coaching'
} = Astro.props;
---

<section class={`ac-section ac-situations ac-theme--${theme}`} id={sectionId}>
  <div class="ac-container">
    <div class="ac-section-heading ac-section-heading--split">
      <div>
        <p class="ac-eyebrow"><span></span>{subtitle}</p>
        <h2>{title}</h2>
      </div>
      <p class="ac-section-heading__lead">{lead}</p>
    </div>

    <div class="ac-situations__body">
      <div class="ac-situation-index" aria-label="Situations abordées">
        {tags.map((tag, index) => (
          <div class={`ac-situation-item ac-situation-item--${tag.size || 'md'}`}>
            <span class="ac-situation-item__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="ac-situation-item__dot" data-color={tag.color || 'blue'}></span>
            <span class="ac-situation-item__text">{tag.text}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
              <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        ))}
      </div>

      {quote && (
        <aside class="ac-editorial-quote">
          <span class="ac-editorial-quote__mark" aria-hidden="true">“</span>
          <p set:html={quote}></p>
          <span class="ac-editorial-quote__line" aria-hidden="true"></span>
          <small>Un point de départ, jamais une étiquette</small>
        </aside>
      )}
    </div>
  </div>
</section>
