---
import { BOOKING_URL } from '../config/site';
---

<section class="section hero-anne-full hypnose-hero" id="accueil">
  <div class="w-layout-blockcontainer container w-container">
    <div class="hero-full-content">
      <div class="hero-badge-pill hero-badge-pill--hypnose">
        <span class="hero-badge-dot"></span>
        Hypnose Ericksonienne thérapeutique · Ressources &amp; libre arbitre
      </div>
      <h1 hero-text="" class="hero-full-title">Mobiliser vos ressources profondes pour libérer le changement.</h1>
      <p class="hero-full-lead">
        Une démarche respectueuse, collaborative et sans perte de contrôle. L'hypnose Ericksonienne permet de dialoguer avec votre inconscient pour assouplir les résistances et activer vos solutions intérieures à votre rythme.
      </p>
      <div class="hero-full-buttons">
        <a href={BOOKING_URL} class="primary-button button-hero-primary--gold w-inline-block" data-booking-link>
          <div class="button-text-wrapper">
            <div class="button-text-inner">
              <div button-text="" class="button-text">Prendre rendez-vous</div>
              <div button-text="" class="button-text">Prendre rendez-vous</div>
            </div>
          </div>
        </a>
        <a href="#deroulement" class="primary-button button-hero-secondary button-hero-secondary--gold w-inline-block">
          <div class="button-text-wrapper">
            <div class="button-text-inner">
              <div button-text="" class="button-text">Découvrir le protocole</div>
              <div button-text="" class="button-text">Découvrir le protocole</div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<div class="hero-scroll-wrapper hypnose-hero-scroll">
  <a href="#reperes" class="hero-scroll-indicator dark-mode" aria-label="Faire défiler vers votre point de départ">
    <span class="apple-mouse-icon">
      <span class="apple-mouse-wheel"></span>
    </span>
    <span class="hero-scroll-label">Découvrir</span>
  </a>
</div>
