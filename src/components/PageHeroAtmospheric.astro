---
import { BOOKING_URL } from '../config/site';

interface Props {
  badgeText: string;
  badgeType?: 'coaching' | 'therapies' | 'hypnose' | 'couple' | 'about' | 'pricing';
  title: string;
  lead: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  scrollTargetId?: string;
  scrollLabel?: string;
  heroImage?: string;
  heroAlt?: string;
}

const {
  badgeText,
  badgeType = 'coaching',
  title,
  lead,
  primaryCtaText = 'Prendre rendez-vous',
  primaryCtaLink = BOOKING_URL,
  secondaryCtaText = 'Découvrir la méthode',
  secondaryCtaLink = '#reperes',
  scrollTargetId = 'reperes',
  scrollLabel = 'Découvrir',
  heroImage = '/assets/anne%20hero%20header%202.webp',
  heroAlt = 'Anne Chataigner dans son cabinet d’accompagnement'
} = Astro.props;

const resolvedPrimaryCtaLink = primaryCtaLink === '#contact' ? BOOKING_URL : primaryCtaLink;
const pageLinks = badgeType === 'about'
  ? [
      { href: '#reperes', label: 'La posture' },
      { href: '#parcours', label: 'Le parcours' },
      { href: '#outils', label: 'Les approches' },
      { href: '#faq', label: 'FAQ' }
    ]
  : badgeType === 'pricing'
    ? [
        { href: '#reperes', label: 'Le cadre' },
        { href: '#grille-tarifs', label: 'Les tarifs' },
        { href: '#modalites', label: 'Modalités' },
        { href: '#faq', label: 'FAQ' }
      ]
    : [
        { href: '#reperes', label: 'Votre point de départ' },
        { href: '#approche-eclairage', label: 'La méthode' },
        { href: '#deroulement', label: 'Le déroulement' },
        { href: '#faq', label: 'FAQ' }
      ];
---

<section class={`ac-hero ac-hero--${badgeType}`} id="accueil">
  <div class="ac-hero__media" aria-hidden="true">
    <img src={heroImage} alt="" width="1536" height="1024" fetchpriority="high" />
    <div class="ac-hero__veil"></div>
  </div>

  <div class="ac-container ac-hero__inner">
    <div class="ac-hero__copy">
      <p class="ac-eyebrow ac-eyebrow--light"><span></span>{badgeText}</p>
      <h1>{title}</h1>
      <p class="ac-hero__lead">{lead}</p>

      <div class="ac-hero__actions">
        <a href={resolvedPrimaryCtaLink} class="ac-button ac-button--light" data-booking-link>
          <span>{primaryCtaText}</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        {secondaryCtaText && (
          <a href={secondaryCtaLink} class="ac-text-button ac-text-button--light">
            <span>{secondaryCtaText}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
              <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>

      <div class="ac-hero__details" aria-label="Modalités principales">
        <span>Voisins-le-Bretonneux</span>
        <span>Cabinet &amp; visioconférence</span>
      </div>
    </div>

    <div class="ac-hero__signature" aria-hidden="true">
      <span>Anne</span>
      <small>Un espace pour déposer, comprendre et avancer</small>
    </div>
  </div>
</section>

<nav class="ac-page-nav" aria-label="Dans cette page">
  <div class="ac-container ac-page-nav__inner">
    <a href={`#${scrollTargetId}`} class="ac-page-nav__label">{scrollLabel}</a>
    <div class="ac-page-nav__links">
      {pageLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
</nav>
