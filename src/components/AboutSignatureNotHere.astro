<section class="section about-signature-dark" id="deontologie">
  <div class="w-layout-blockcontainer container w-container">
    <div class="about-signature-dark__inner" data-coaching-reveal>
      
      <div class="about-signature-dark__header">
        <div class="about-badge-dark">
          <span class="about-badge-dark__dot"></span>
          Cadre éthique &amp; déontologie
        </div>
        <h2 class="about-signature-dark__title">Ce qui ne se passera pas ici.</h2>
        <p class="about-signature-dark__lead">
          Poser des limites claires est la première condition de la confiance. Voici ce que vous ne trouverez jamais au cabinet.
        </p>
      </div>

      <!-- Grille des 4 Engagements Négatifs Transformateurs -->
      <div class="about-signature-dark__grid">
        
        <div class="about-signature-card">
          <div class="about-signature-card__icon" aria-hidden="true">✕</div>
          <h3 class="about-signature-card__title">Pas d'étiquette à coller</h3>
          <p class="about-signature-card__desc">
            Vous n'êtes pas un diagnostic, une typologie de personnalité figée ou un cas d'école. Chaque vécu est singulier et respecté sans jugement moral.
          </p>
        </div>

        <div class="about-signature-card">
          <div class="about-signature-card__icon" aria-hidden="true">✕</div>
          <h3 class="about-signature-card__title">Pas de solution plaquée</h3>
          <p class="about-signature-card__desc">
            Aucune recette toute faite, aucun dogme théorique ni protocole standardisé. Nous co-construisons ce qui résonne avec votre réalité propre.
          </p>
        </div>

        <div class="about-signature-card">
          <div class="about-signature-card__icon" aria-hidden="true">✕</div>
          <h3 class="about-signature-card__title">Pas de course contre votre rythme</h3>
          <p class="about-signature-card__desc">
            Les transformations profondes ne se forcent pas. Vous avancez à votre propre vitesse, en restant maître(sse) de chaque étape et de vos décisions.
          </p>
        </div>

        <div class="about-signature-card">
          <div class="about-signature-card__icon" aria-hidden="true">✕</div>
          <h3 class="about-signature-card__title">Pas de promesse magique</h3>
          <p class="about-signature-card__desc">
            Aucune illusion de baguette magique : un travail lucide, pragmatique et bienveillant qui mobilise ce que vous portez déjà en vous.
          </p>
        </div>

      </div>

      <!-- Bandeau Conclusif Positif -->
      <div class="about-signature-dark__footer">
        <p class="about-signature-dark__manifesto-line">
          Un cadre clair. Une écoute réelle. Un accompagnement ajusté.
        </p>
        <div class="about-signature-dark__pills">
          <span>Confidentialité absolue</span>
          <span class="about-signature-dark__bullet">·</span>
          <span>Libre arbitre garanti</span>
          <span class="about-signature-dark__bullet">·</span>
          <span>Sécurité relationnelle</span>
        </div>
      </div>

    </div>
  </div>
</section>
