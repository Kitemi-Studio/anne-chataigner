---
interface ServiceLink {
  title: string;
  description: string;
  url: string;
  tag: string;
  theme: string;
}

interface Props {
  currentService: 'coaching' | 'therapies' | 'hypnose' | 'couple';
}

const { currentService } = Astro.props;

const allServices: Record<string, ServiceLink> = {
  coaching: {
    title: 'Coaching individuel',
    description: 'Clarifier une transition, dépasser un blocage professionnel ou personnel et avancer par petits pas.',
    url: '/coaching',
    tag: 'Transition & action',
    theme: 'coaching'
  },
  therapies: {
    title: 'Thérapies brèves',
    description: 'Apaiser la charge mentale, dénouer un blocage émotionnel et retrouver un équilibre concret au quotidien.',
    url: '/therapies-breves',
    tag: 'Équilibre & émotion',
    theme: 'therapies'
  },
  hypnose: {
    title: 'Hypnose Ericksonienne',
    description: 'Mobiliser vos ressources en douceur pour ouvrir de nouvelles perspectives face aux automatismes.',
    url: '/hypnose-ericksonienne',
    tag: 'Ressources profondes',
    theme: 'hypnose'
  },
  couple: {
    title: 'Consultation de couple',
    description: 'Un espace neutre et sécurisant pour dialoguer, clarifier les besoins de chacun et cheminer ensemble.',
    url: '/consultation-couple',
    tag: 'Relation & dialogue',
    theme: 'couple'
  }
};

const displayedServices = Object.entries(allServices)
  .filter(([key]) => key !== currentService)
  .slice(0, 2)
  .map(([, service]) => service);
---

<section class="ac-section ac-related">
  <div class="ac-container">
    <div class="ac-related__heading">
      <div>
        <p class="ac-eyebrow"><span></span>Approches complémentaires</p>
        <h2>Une autre porte d’entrée peut parfois être plus juste.</h2>
      </div>
      <p>Les approches se répondent sans se confondre. Le premier échange permet de choisir un cadre adapté à votre situation.</p>
    </div>

    <div class="ac-related__list">
      {displayedServices.map((service, index) => (
        <a href={service.url} class={`ac-related__item ac-theme--${service.theme}`}>
          <span class="ac-related__index">0{index + 1}</span>
          <div class="ac-related__copy">
            <p class="ac-related__tag">{service.tag}</p>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <span class="ac-related__arrow" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none">
              <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
