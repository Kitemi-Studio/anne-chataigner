---
interface ServiceLink {
  title: string;
  description: string;
  url: string;
  tag: string;
  tagClass?: string;
}

interface Props {
  currentService: 'coaching' | 'therapies' | 'hypnose' | 'couple';
}

const { currentService } = Astro.props;

const allServices: Record<string, ServiceLink> = {
  coaching: {
    title: "Coaching individuel",
    description: "Clarifier une transition, dépasser un blocage professionnel ou personnel et avancer par petits pas.",
    url: "/coaching",
    tag: "Transition & Action",
    tagClass: "interior-badge--coaching"
  },
  therapies: {
    title: "Thérapies brèves",
    description: "Apaiser la charge mentale, dénouer un blocage émotionnel et retrouver un équilibre concret au quotidien.",
    url: "/therapies-breves",
    tag: "Équilibre & Émotion",
    tagClass: "interior-badge--therapies"
  },
  hypnose: {
    title: "Hypnose Ericksonienne",
    description: "Mobiliser vos ressources inconscientes en douceur pour ouvrir de nouvelles perspectives de changement.",
    url: "/hypnose-ericksonienne",
    tag: "Ressources profondes",
    tagClass: "interior-badge--hypnose"
  },
  couple: {
    title: "Consultation de couple",
    description: "Un espace neutre et sécurisant pour dialoguer, clarifier les besoins de chacun et cheminer ensemble.",
    url: "/consultation-couple",
    tag: "Relation & Dialogue",
    tagClass: "interior-badge--couple"
  }
};

const displayedServices = Object.entries(allServices)
  .filter(([key]) => key !== currentService)
  .slice(0, 2)
  .map(([, service]) => service);
---

<section class="related-services-section">
  <div class="w-layout-blockcontainer container w-container">
    <div class="interior-section-header" style="margin-bottom: 40px;">
      <div class="interior-section-subtitle">
        <span class="subtitle-bullet-dot"></span>
        <span>Approches complémentaires</span>
      </div>
      <h2 class="interior-section-title" style="font-size: 32px;">Poursuivre votre découverte</h2>
    </div>

    <div class="related-services-grid">
      {displayedServices.map((service) => (
        <a href={service.url} class="related-service-card">
          <div class="related-service-header">
            <span class={`interior-badge ${service.tagClass}`} style="margin-bottom: 0;">
              <span class="interior-badge-dot"></span>
              {service.tag}
            </span>
            <div class="related-service-arrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
          <h3 class="related-service-title">{service.title}</h3>
          <p class="related-service-text" style="margin-top: 8px;">{service.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
